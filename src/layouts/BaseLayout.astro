---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import BackToTop from '../components/BackToTop.astro';
import JsonLd from '../components/JsonLd.astro';
import { siteConfig } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: 'home' | 'clinic' | 'faq' | 'article' | 'page';
  faqs?: { question: string; answer: string }[];
  article?: {
    headline: string;
    description: string;
    datePublished?: string;
    authorName?: string;
  };
}

const {
  title = `${siteConfig.name} – ${siteConfig.tagline}`,
  description = siteConfig.description,
  canonicalPath = Astro.url.pathname,
  type = 'page',
  faqs = [],
  article,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || siteConfig.url;
const isNoindex = import.meta.env.PUBLIC_NOINDEX === 'true';

const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const ogImage = `${siteUrl}/images/hear-maxx-og.png`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Environment-aware Indexation (Staging disallow / Production index) -->
    <meta
      name="robots"
      content={isNoindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <!-- Detection for progressive scroll reveal & motion -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Font Preloads (critical self-hosted fonts) -->
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/outfit-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_CA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Structured Data -->
    <JsonLd
      type={type}
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      faqs={faqs}
      article={article}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#f8fafd] text-[#334155] antialiased font-sans relative selection:bg-brand/15 selection:text-brand">
    <!-- Ambient Background Orbs -->
    <div class="ambient-orb ambient-orb-1" aria-hidden="true"></div>
    <div class="ambient-orb ambient-orb-2" aria-hidden="true"></div>
    <div class="ambient-orb ambient-orb-3" aria-hidden="true"></div>

    <!-- Reading Progress Bar on long-form articles -->
    {type === 'article' && (
      <div
        id="reading-progress-bar"
        class="fixed top-0 left-0 h-1 bg-gradient-to-r from-brand to-accent z-[70] w-0 transition-all duration-75"
        aria-hidden="true"
      />
    )}

    <!-- Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[110] focus:px-4 focus:py-2.5 focus:bg-brand focus:text-white focus:font-semibold focus:rounded-xl focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-brand"
    >
      Skip to main content
    </a>

    <!-- Desktop Dropdown Scrim (z-40: dims page content behind header) -->
    <div
      id="desktop-dropdown-scrim"
      class="fixed inset-0 bg-[#0f1e36]/30 backdrop-blur-[4px] z-[40] hidden opacity-0 transition-opacity duration-200 pointer-events-none"
      style="z-index: 40;"
      aria-hidden="true"
    ></div>

    <Header />

    <main id="main-content" class="flex-grow pb-16 lg:pb-0">
      <slot />
    </main>

    <Footer />

    <!-- Fixed Mobile Action Bar & Back to Top Floating Controls -->
    <MobileActionBar />
    <BackToTop />

    <!-- Lightweight progressive interaction & scroll reveal enhancer (<0.5 KB) -->
    <script>
      function setupEnhancements() {
        // 1. Reading progress for articles
        const progressBar = document.getElementById('reading-progress-bar');
        if (progressBar) {
          const updateProgress = () => {
            const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
            if (totalHeight > 0) {
              const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
              progressBar.style.width = `${progress}%`;
            }
          };
          window.addEventListener('scroll', updateProgress, { passive: true });
          updateProgress();
        }

        // 2. Scroll reveal observer
        if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const revealElements = document.querySelectorAll('.scroll-reveal:not(.revealed)');
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

          revealElements.forEach((el) => observer.observe(el));
        } else {
          document.querySelectorAll('.scroll-reveal').forEach((el) => el.classList.add('revealed'));
        }
      }

      setupEnhancements();
      document.addEventListener('astro:page-load', setupEnhancements);
    </script>
  </body>
</html>
