---
interface FaqItem {
  question: string;
  answer: string;
  badge?: string;
  mythPill?: boolean;
  factPill?: boolean;
}

interface Props {
  items: FaqItem[];
  groupName?: string;
  title?: string;
  subtitle?: string;
  showControls?: boolean;
  enableJsonLd?: boolean;
  class?: string;
}

const {
  items = [],
  groupName,
  title,
  subtitle,
  showControls = items.length >= 4,
  enableJsonLd = false,
  class: className = '',
} = Astro.props;

const accordionId = `faq-${Math.random().toString(36).substring(2, 9)}`;

const faqSchema = enableJsonLd
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

<div class={`space-y-4 ${className}`} id={accordionId}>
  {title && (
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
          {title}
        </h2>
        {subtitle && <p class="text-secondary text-sm mt-1">{subtitle}</p>}
      </div>

      {showControls && (
        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            class="expand-all-btn px-3 py-1.5 rounded-full text-xs font-semibold text-brand hover:text-brand-dark bg-white/70 hover:bg-white border border-border-subtle transition-colors cursor-pointer"
            aria-label="Expand all accordion items"
          >
            Expand All
          </button>
          <button
            type="button"
            class="collapse-all-btn px-3 py-1.5 rounded-full text-xs font-semibold text-text-muted hover:text-primary bg-white/70 hover:bg-white border border-border-subtle transition-colors cursor-pointer"
            aria-label="Collapse all accordion items"
          >
            Collapse All
          </button>
        </div>
      )}
    </div>
  )}

  <div class="space-y-3.5">
    {items.map((item, index) => {
      const numBadge = String(index + 1).padStart(2, '0');
      return (
        <details
          name={groupName}
          class="group glass-light rounded-2xl sm:rounded-3xl border border-white/80 p-5 sm:p-6 transition-all duration-280 ease-out open:glass-strong open:border-brand/40 open:shadow-[0_12px_36px_rgba(0,90,150,0.12)] hover:border-brand/30"
        >
          <summary class="flex items-start sm:items-center justify-between gap-4 cursor-pointer select-none">
            <div class="flex items-start sm:items-center gap-3 sm:gap-4 flex-grow">
              {item.mythPill ? (
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-rose-100 text-rose-700 border border-rose-200/80 shrink-0 mt-0.5 sm:mt-0">
                  Myth {index + 1}
                </span>
              ) : item.badge ? (
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand/10 text-brand shrink-0">
                  {item.badge}
                </span>
              ) : (
                <span class="w-8 h-8 rounded-full bg-brand/10 text-brand font-bold text-xs flex items-center justify-center shrink-0">
                  {numBadge}
                </span>
              )}

              <span class="font-bold text-primary text-base sm:text-lg leading-snug group-hover:text-brand transition-colors">
                {item.question}
              </span>
            </div>

            <!-- Circular animated plus/minus icon -->
            <div
              class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white/90 border border-border-subtle shadow-2xs flex items-center justify-center shrink-0 group-open:rotate-45 group-open:bg-brand group-open:text-white transition-transform duration-280 ease-out mt-0.5 sm:mt-0"
              aria-hidden="true"
            >
              <svg
                class="w-4 h-4 text-brand group-open:text-white transition-colors"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
              </svg>
            </div>
          </summary>

          <!-- Smooth Grid Expansion Container -->
          <div class="grid grid-rows-[0fr] group-open:grid-rows-[1fr] transition-[grid-template-rows,opacity] duration-280 ease-out opacity-0 group-open:opacity-100">
            <div class="overflow-hidden">
              <div class="pt-4 mt-3 border-t border-border-subtle/60 text-secondary text-sm sm:text-base leading-relaxed space-y-2">
                {item.factPill && (
                  <div class="mb-2">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200/80">
                      <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                      </svg>
                      Clinical Fact
                    </span>
                  </div>
                )}
                <div class="prose-p:leading-relaxed break-anywhere">
                  {item.answer}
                </div>
              </div>
            </div>
          </div>
        </details>
      );
    })}
  </div>
</div>

{enableJsonLd && faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<script>
  function setupAccordionControls() {
    document.querySelectorAll('.expand-all-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const container = (e.currentTarget as HTMLElement).closest('.space-y-4');
        container?.querySelectorAll('details').forEach((d) => (d.open = true));
      });
    });

    document.querySelectorAll('.collapse-all-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const container = (e.currentTarget as HTMLElement).closest('.space-y-4');
        container?.querySelectorAll('details').forEach((d) => (d.open = false));
      });
    });
  }

  setupAccordionControls();
  document.addEventListener('astro:page-load', setupAccordionControls);
</script>
