---
import Icon from './Icon.astro';

interface Props {
  label: string;
  categories: {
    category: string;
    items: {
      label: string;
      href: string;
      description?: string;
    }[];
  }[];
  currentPath?: string;
}

const { label, categories, currentPath = '' } = Astro.props;
const isChildActive = categories.some((c) => c.items.some((i) => i.href === currentPath));
---

<div class="relative group" id="desktop-dropdown">
  <!-- Trigger Button -->
  <button
    type="button"
    id="desktop-dropdown-trigger"
    class={`flex items-center gap-1.5 py-2 px-1 text-sm xl:text-[15px] font-semibold transition-colors focus:outline-none cursor-pointer nav-link-underline ${
      isChildActive ? 'text-brand font-bold is-active' : 'text-primary hover:text-brand'
    }`}
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="desktop-dropdown-panel"
  >
    <span>{label}</span>
    <Icon
      name="chevron-down"
      class="w-4 h-4 text-text-muted group-hover:text-brand transition-transform duration-200"
      id="dropdown-chevron"
    />
  </button>

  <!-- Dropdown Panel (10-12px below header, with invisible hover bridge) -->
  <div
    id="desktop-dropdown-panel"
    class="hidden absolute top-[calc(100%+11px)] left-0 w-[600px] opacity-0 translate-y-2 pointer-events-none transition-all duration-180 z-[60] before:content-[''] before:absolute before:-top-3 before:left-0 before:right-0 before:h-4 before:bg-transparent"
    style="z-index: 60;"
    aria-labelledby="desktop-dropdown-trigger"
  >
    <div class="glass-dropdown p-6 grid grid-cols-2 gap-6 ring-1 ring-brand/10">
      {categories.map((cat) => (
        <div>
          <span class="block text-[11px] font-bold uppercase tracking-wider text-brand mb-3 pb-1 border-b border-slate-200/80">
            {cat.category}
          </span>
          <ul class="space-y-1.5">
            {cat.items.map((item) => {
              const isActive = currentPath === item.href;
              return (
                <li>
                  <a
                    href={item.href}
                    class={`group/link block relative pl-3.5 pr-3 py-2.5 rounded-xl transition-colors duration-150 before:content-[''] before:absolute before:left-1 before:top-2.5 before:bottom-2.5 before:w-1 before:rounded-full before:bg-brand before:transition-opacity ${
                      isActive
                        ? 'bg-brand/10 before:opacity-100'
                        : 'hover:bg-brand/5 before:opacity-0 hover:before:opacity-100'
                    }`}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    <span class={`block text-sm font-semibold transition-colors ${
                      isActive ? 'text-brand' : 'text-[#0f1e36] group-hover/link:text-brand'
                    }`}>
                      {item.label}
                    </span>
                    {item.description && (
                      <span class="block text-xs text-[#334155] mt-0.5 leading-relaxed font-normal">
                        {item.description}
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function setupDropdown() {
    const dropdown = document.getElementById('desktop-dropdown');
    const trigger = document.getElementById('desktop-dropdown-trigger');
    const panel = document.getElementById('desktop-dropdown-panel');
    const scrim = document.getElementById('desktop-dropdown-scrim');
    const chevron = document.getElementById('dropdown-chevron');

    if (!dropdown || !trigger || !panel) return;

    let isOpen = false;

    function openDropdown() {
      if (isOpen) return;
      isOpen = true;
      trigger?.setAttribute('aria-expanded', 'true');
      
      // Panel animation
      panel?.classList.remove('hidden', 'pointer-events-none');
      // trigger reflow
      void panel?.offsetWidth;
      panel?.classList.add('opacity-100', 'translate-y-0');
      panel?.classList.remove('opacity-0', 'translate-y-2');
      chevron?.classList.add('rotate-180');

      // Scrim
      if (scrim) {
        scrim.classList.remove('hidden', 'pointer-events-none');
        void scrim.offsetWidth;
        scrim.classList.add('opacity-100', 'pointer-events-auto');
        scrim.classList.remove('opacity-0');
      }
    }

    function closeDropdown() {
      if (!isOpen) return;
      isOpen = false;
      trigger?.setAttribute('aria-expanded', 'false');

      panel?.classList.add('opacity-0', 'translate-y-2');
      panel?.classList.remove('opacity-100', 'translate-y-0');
      chevron?.classList.remove('rotate-180');

      if (scrim) {
        scrim.classList.add('opacity-0');
        scrim.classList.remove('opacity-100', 'pointer-events-auto');
      }

      setTimeout(() => {
        if (!isOpen) {
          panel?.classList.add('hidden', 'pointer-events-none');
          scrim?.classList.add('hidden', 'pointer-events-none');
        }
      }, 180);
    }

    // Hover listeners
    dropdown.addEventListener('mouseenter', openDropdown);
    dropdown.addEventListener('mouseleave', closeDropdown);

    // Click trigger toggle
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    // Keyboard support: Enter / Space / ArrowDown
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
        e.preventDefault();
        openDropdown();
        const firstLink = panel?.querySelector('a') as HTMLElement | null;
        firstLink?.focus();
      }
    });

    // Panel keyboard navigation
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDropdown();
        trigger.focus();
      }
    });

    // Scrim click to close
    scrim?.addEventListener('click', () => {
      closeDropdown();
    });

    // Global Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeDropdown();
        trigger.focus();
      }
    });
  }

  setupDropdown();
  document.addEventListener('astro:page-load', setupDropdown);
</script>
