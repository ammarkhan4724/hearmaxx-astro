---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
import {
  brandBernafon,
  brandSignia,
  brandOticon,
  brandWidex,
  brandStarkey,
  brandPhonak,
} from '../assets';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Trusted by Leading Hearing Aid Brands',
  subtitle = 'We partner with world-renowned hearing technology innovators to bring you the highest level of auditory clarity and comfort.',
} = Astro.props;

const brandImageMap: Record<string, ImageMetadata> = {
  bernafon: brandBernafon,
  signia: brandSignia,
  oticon: brandOticon,
  widex: brandWidex,
  starkey: brandStarkey,
  phonak: brandPhonak,
};
---

<section class="py-14" aria-labelledby="brand-strip-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="inline-block px-3 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider mb-2">
          Global Innovations
        </span>
        <h2 id="brand-strip-heading" class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
          {title}
        </h2>
        <p class="text-sm text-secondary mt-2 leading-relaxed">
          {subtitle}
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6 items-center">
        {siteConfig.brandPartners.map((brand) => {
          const imgAsset = brandImageMap[brand.slug];
          return (
            <a
              href={brand.website}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center p-4 glass-strong rounded-2xl border border-white/90 shadow-2xs glass-card-hover group h-22"
              title={`Visit ${brand.name} official website`}
            >
              {imgAsset ? (
                <Image
                  src={imgAsset}
                  alt={`${brand.name} official hearing aid manufacturer logo`}
                  class="max-h-9 w-auto max-w-[120px] object-contain grayscale group-hover:grayscale-0 opacity-80 group-hover:opacity-100 transition-all duration-200"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="font-bold text-primary text-sm">{brand.name}</span>
              )}
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>
