---
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container footer__grid">
    <div>
      <a href="/" class="brand">Sound<em>&</em>Clarity</a>
      <p>Hearing care that puts you first. Certified specialists, honest advice, and support that continues long after your first fitting.</p>
    </div>

    <div>
      <h4>Hearing Health</h4>
      <ul>
        <li><a href="#hearing-health">Understanding hearing loss</a></li>
        <li><a href="#hearing-health">Tinnitus &amp; ear health</a></li>
        <li><a href="#solutions">Hearing solutions</a></li>
        <li><a href="#services">Our services</a></li>
      </ul>
    </div>

    <div>
      <h4>Visit Us</h4>
      <ul>
        <li>123 Example Street, Suite 100</li>
        <li>Your City, Province A1A 1A1</li>
        <li><a href="tel:+15550000000">+1 (555) 000-0000</a></li>
        <li><a href="mailto:hello@example.com">hello@example.com</a></li>
      </ul>
    </div>

    <div>
      <h4>Opening Hours</h4>
      <ul>
        <li>Mon – Fri: 9:00 – 17:30</li>
        <li>Saturday: 10:00 – 14:00</li>
        <li>Sunday: Closed</li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {year} Sound &amp; Clarity. All rights reserved.</span>
    <span>Placeholder site for demonstration purposes.</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: #b8c4d6;
    padding: 4rem 0 1.5rem;
    font-size: 0.95rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }
  .brand {
    display: inline-block;
    font-weight: 800;
    font-size: 1.3rem;
    color: #fff;
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .brand em { color: #4cb8f0; font-style: normal; }
  .site-footer p { color: #b8c4d6; }
  .site-footer h4 { color: #fff; font-size: 1rem; margin-bottom: 1rem; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .site-footer a { color: #b8c4d6; text-decoration: none; }
  .site-footer a:hover { color: #fff; }
  .footer__bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  @media (max-width: 860px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>
