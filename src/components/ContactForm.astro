---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site';
---

<div class="glass-strong rounded-3xl p-6 sm:p-10 border border-white/90 shadow-xl">
  <div class="mb-6 space-y-1">
    <span class="inline-block px-3 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider mb-1">
      Direct Inquiry
    </span>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">Send us a message</h2>
    <p class="text-sm text-secondary">
      Fields marked * with an asterisk are required.
    </p>
  </div>

  <form id="contact-form" action="/form-handler.php" method="POST" class="space-y-4">
    <input type="hidden" name="form_type" value="contact" />
    <!-- Honeypot -->
    <div class="hidden" aria-hidden="true">
      <label for="contact-hp">Do not fill this</label>
      <input type="text" id="contact-hp" name="_hp_check" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Name -->
    <div>
      <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-primary mb-1.5">
        Full Name <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="contact-name"
        name="full_name"
        required
        autocomplete="name"
        placeholder="e.g. John Doe"
        class="w-full px-4 py-3 rounded-xl border border-white/90 focus:border-brand focus:ring-2 focus:ring-brand/20 text-sm text-primary transition-colors bg-white/80 shadow-2xs placeholder:text-text-muted/60"
      />
    </div>

    <!-- Phone & Email Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="contact-phone" class="block text-xs font-bold uppercase tracking-wider text-primary mb-1.5">
          Phone Number <span class="text-red-500">*</span>
        </label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          required
          autocomplete="tel"
          placeholder="e.g. (905) 232-7860"
          class="w-full px-4 py-3 rounded-xl border border-white/90 focus:border-brand focus:ring-2 focus:ring-brand/20 text-sm text-primary transition-colors bg-white/80 shadow-2xs placeholder:text-text-muted/60"
        />
      </div>

      <div>
        <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-primary mb-1.5">
          Email Address <span class="text-text-muted font-normal">(Optional)</span>
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          autocomplete="email"
          placeholder="e.g. john@example.com"
          class="w-full px-4 py-3 rounded-xl border border-white/90 focus:border-brand focus:ring-2 focus:ring-brand/20 text-sm text-primary transition-colors bg-white/80 shadow-2xs placeholder:text-text-muted/60"
        />
      </div>
    </div>

    <!-- Clinic Selector -->
    <div>
      <label for="contact-clinic" class="block text-xs font-bold uppercase tracking-wider text-primary mb-1.5">
        Preferred Clinic Location
      </label>
      <select
        id="contact-clinic"
        name="clinic"
        class="w-full px-4 py-3 rounded-xl border border-white/90 focus:border-brand focus:ring-2 focus:ring-brand/20 text-sm text-primary transition-colors bg-white/80 shadow-2xs font-medium cursor-pointer"
      >
        <option value="Mississauga Clinic">Mississauga Clinic ({siteConfig.clinics.mississauga.street})</option>
        <option value="York Clinic">York Clinic (Jane Park Plaza)</option>
        <option value="Either Clinic">Either Location / General Inquiry</option>
      </select>
    </div>

    <!-- Message -->
    <div>
      <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-primary mb-1.5">
        Your Message or Hearing Concerns <span class="text-red-500">*</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        required
        placeholder="Tell us what you're experiencing or ask any questions..."
        class="w-full px-4 py-3 rounded-xl border border-white/90 focus:border-brand focus:ring-2 focus:ring-brand/20 text-sm text-primary transition-colors bg-white/80 shadow-2xs placeholder:text-text-muted/60"
      ></textarea>
    </div>

    <!-- Status feedback message box -->
    <div id="contact-status" class="hidden p-4 rounded-xl text-sm font-medium" role="alert" aria-live="polite"></div>

    <!-- Submit Button -->
    <button
      type="submit"
      id="contact-submit"
      class="btn-primary w-full !py-3.5 !rounded-xl !text-base shadow-md cursor-pointer justify-center"
    >
      <span>Send message</span>
      <Icon name="chevron-right" class="w-4 h-4" />
    </button>

    <p class="text-xs text-text-muted text-center pt-2">
      We only use your details to reply to this enquiry.
    </p>
  </form>
</div>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusBox = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

    if (!form || !statusBox || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span>Sending...</span>';

      statusBox.className = 'hidden';

      try {
        const formData = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
          },
          body: formData,
        });

        const data = await res.json();

        if (res.ok && data.status === 'success') {
          statusBox.className = 'p-4 rounded-xl text-sm font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 block';
          statusBox.textContent = data.message || 'Thank you! Your message has been sent successfully.';
          form.reset();
        } else {
          statusBox.className = 'p-4 rounded-xl text-sm font-medium bg-red-50 text-red-800 border border-red-200 block';
          statusBox.textContent = data.message || 'There was an issue sending your message. Please give us a direct call.';
        }
      } catch (err) {
        statusBox.className = 'p-4 rounded-xl text-sm font-medium bg-red-50 text-red-800 border border-red-200 block';
        statusBox.textContent = 'Network error. Please call our clinic directly at (905) 232-7860 or (416) 792-8792.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
