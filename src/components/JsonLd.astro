---
import { siteConfig } from '../data/site';

interface Props {
  type?: 'home' | 'clinic' | 'faq' | 'article' | 'page';
  title?: string;
  description?: string;
  canonicalUrl?: string;
  faqs?: { question: string; answer: string }[];
  article?: {
    headline: string;
    description: string;
    datePublished?: string;
    authorName?: string;
  };
}

const {
  type = 'page',
  title = siteConfig.name,
  description = siteConfig.description,
  canonicalUrl = siteConfig.url,
  faqs = [],
  article,
} = Astro.props;

// 1. Organization Schema
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  url: siteConfig.url,
  logo: `${siteConfig.url}/images/hear-maxx-logo.png`,
  description: siteConfig.description,
  email: siteConfig.generalEmail,
  sameAs: [siteConfig.socials.facebook, siteConfig.socials.instagram],
};

// 2. Clinics Schema (MedicalBusiness / Audiologist)
const mississaugaClinicSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': `${siteConfig.url}/#clinic-mississauga`,
  name: siteConfig.clinics.mississauga.name,
  description: 'Audiology and hearing aid dispensary clinic in Mississauga, Ontario.',
  url: `${siteConfig.url}/find-our-clinics/`,
  telephone: siteConfig.clinics.mississauga.phone,
  email: siteConfig.clinics.mississauga.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.clinics.mississauga.street,
    addressLocality: siteConfig.clinics.mississauga.city,
    addressRegion: siteConfig.clinics.mississauga.province,
    postalCode: siteConfig.clinics.mississauga.postalCode,
    addressCountry: 'CA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 43.555848,
    longitude: -79.664426,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '13:00',
      closes: '16:00',
    },
  ],
  priceRange: '$$',
};

const yorkClinicSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': `${siteConfig.url}/#clinic-york`,
  name: siteConfig.clinics.york.name,
  description: 'Hearing care clinic and certified audiologist consultations in York, Ontario.',
  url: `${siteConfig.url}/find-our-clinics/`,
  telephone: siteConfig.clinics.york.phone,
  email: siteConfig.clinics.york.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.clinics.york.street,
    addressLocality: siteConfig.clinics.york.city,
    addressRegion: siteConfig.clinics.york.province,
    postalCode: siteConfig.clinics.york.postalCode,
    addressCountry: 'CA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 43.684126,
    longitude: -79.497576,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '09:00',
      closes: '12:00',
    },
  ],
  priceRange: '$$',
};

// 3. FAQ Schema
const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
} : null;

// 4. Article Schema
const articleSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: article.headline,
  description: article.description,
  datePublished: article.datePublished || '2025-01-01',
  author: {
    '@type': 'Person',
    name: article.authorName || siteConfig.specialist.name,
    jobTitle: siteConfig.specialist.title,
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
  },
} : null;

// 5. BreadcrumbList Schema
const isSubpage = canonicalUrl && canonicalUrl !== siteConfig.url && canonicalUrl !== `${siteConfig.url}/`;
const breadcrumbName = title.split('|')[0].trim().split('–')[0].trim() || 'Current Page';

const breadcrumbSchema = isSubpage ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteConfig.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: breadcrumbName,
      item: canonicalUrl,
    },
  ],
} : null;
---

{type === 'home' && (
  <>
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(mississaugaClinicSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(yorkClinicSchema)} />
  </>
)}

{type === 'clinic' && (
  <>
    <script type="application/ld+json" set:html={JSON.stringify(mississaugaClinicSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(yorkClinicSchema)} />
  </>
)}

{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

{articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

