---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Dropdown from './Dropdown.astro';
import MobileMenu from './MobileMenu.astro';
import { siteConfig } from '../data/site';
import { hearMaxxLogo } from '../assets';

const currentPath = Astro.url.pathname;
const hearingHealthItem = siteConfig.navigation.find((item) => item.label === 'Hearing Health');
const directNavItems = siteConfig.navigation.filter((item) => item.label !== 'Hearing Health');
---

<!-- Top Rating and Direct Phone Bar -->
<div class="bg-primary text-slate-300 text-xs py-2 px-4 border-b border-brand-navy-dark relative z-50">
  <div class="max-w-[1720px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-10 flex flex-wrap items-center justify-between gap-2">
    <!-- Rating badge -->
    <div class="flex items-center gap-2">
      <div class="flex text-amber-500" role="img" aria-label="5 star rating">
        <Icon name="star" class="w-3.5 h-3.5" />
        <Icon name="star" class="w-3.5 h-3.5" />
        <Icon name="star" class="w-3.5 h-3.5" />
        <Icon name="star" class="w-3.5 h-3.5" />
        <Icon name="star" class="w-3.5 h-3.5" />
      </div>
      <span class="font-medium text-slate-200">{siteConfig.ratingLine}</span>
    </div>

    <!-- Quick phone numbers for clinics -->
    <div class="hidden sm:flex items-center gap-6 text-xs">
      <a
        href={`tel:${siteConfig.clinics.mississauga.phoneRaw}`}
        class="flex items-center gap-1.5 hover:text-white transition-colors"
      >
        <Icon name="phone" class="w-3.5 h-3.5 text-accent" />
        <span>Mississauga: <strong class="text-white">{siteConfig.clinics.mississauga.phone}</strong></span>
      </a>
      <a
        href={`tel:${siteConfig.clinics.york.phoneRaw}`}
        class="flex items-center gap-1.5 hover:text-white transition-colors"
      >
        <Icon name="phone" class="w-3.5 h-3.5 text-accent" />
        <span>York: <strong class="text-white">{siteConfig.clinics.york.phone}</strong></span>
      </a>
    </div>
  </div>
</div>

<!-- Sticky Main Navigation Bar (z-50) -->
<header
  id="main-header"
  class="sticky top-0 z-50 glass-strong border-b border-white/80 transition-colors duration-200"
>
  <div class="max-w-[1720px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-10">
    <div class="flex items-center justify-between h-20 gap-4">
      <!-- Logo Left (Uncropped with intrinsic aspect ratio) -->
      <a href="/" class="shrink-0 flex items-center" aria-label="HearMaxx Home">
        <Image
          src={hearMaxxLogo}
          alt="HearMaxx Logo – Ultimate Hearing Solutions"
          width={hearMaxxLogo.width}
          height={hearMaxxLogo.height}
          class="h-10 sm:h-12 w-auto max-w-[220px] object-contain no-rounded"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Desktop Nav Center/Right -->
      <nav class="hidden lg:flex items-center gap-4 xl:gap-6 2xl:gap-8" aria-label="Main navigation">
        {hearingHealthItem && hearingHealthItem.children && (
          <Dropdown
            label={hearingHealthItem.label}
            categories={hearingHealthItem.children}
            currentPath={currentPath}
          />
        )}

        {directNavItems.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <a
              href={item.href}
              class={`text-sm xl:text-[15px] font-semibold py-2 px-1.5 nav-link-underline transition-colors shrink-0 ${
                isActive
                  ? 'text-brand font-bold is-active'
                  : 'text-primary hover:text-brand'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}

        <a
          href="/find-our-clinics/"
          class={`text-sm xl:text-[15px] font-semibold py-2 px-1.5 nav-link-underline transition-colors shrink-0 ${
            currentPath === '/find-our-clinics/'
              ? 'text-brand font-bold is-active'
              : 'text-primary hover:text-brand'
          }`}
          aria-current={currentPath === '/find-our-clinics/' ? 'page' : undefined}
        >
          Find Our Clinics
        </a>
      </nav>

      <!-- Desktop CTA & Mobile Toggle -->
      <div class="flex items-center gap-3">
        <!-- Always visible Book Appointment! button on desktop -->
        <a
          href="/appointment-form/"
          class="hidden md:inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full bg-gradient-to-r from-brand to-brand-dark text-inverse font-semibold text-sm shadow-sm hover:shadow-brand/25 transition-all duration-200 transform hover:-translate-y-0.5 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 shrink-0 cursor-pointer sheen-card group"
        >
          <Icon name="calendar" class="w-4 h-4 btn-icon-nudge" />
          <span>Book Appointment!</span>
        </a>

        <!-- Mobile Menu Hamburger Trigger -->
        <button
          id="open-mobile-menu"
          type="button"
          class="lg:hidden p-2.5 min-w-[44px] min-h-[44px] rounded-lg text-primary hover:text-brand hover:bg-surface focus:outline-none focus:ring-2 focus:ring-brand flex items-center justify-center cursor-pointer"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
        >
          <Icon name="menu" class="w-6 h-6" id="hamburger-icon" />
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Off-Canvas Drawer (z-100) -->
<MobileMenu currentPath={currentPath} />

<script>
  function setupHeaderScroll() {
    const header = document.getElementById('main-header');
    if (!header) return;

    function handleScroll() {
      if (window.scrollY > 15) {
        header?.classList.add('header-scrolled');
      } else {
        header?.classList.remove('header-scrolled');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  setupHeaderScroll();
  document.addEventListener('astro:page-load', setupHeaderScroll);
</script>
