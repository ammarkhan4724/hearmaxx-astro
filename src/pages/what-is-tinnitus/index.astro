---
import { Image } from 'astro:assets';
import featuredImg from '../../assets/images/tinnitus-diagram.webp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Icon from '../../components/Icon.astro';
import { getEntry } from 'astro:content';
import { siteConfig } from '../../data/site';

const entry = await getEntry('hearingHealth', 'what-is-tinnitus');
if (!entry) {
  throw new Error('Content entry not found');
}

const causesFaqs = [
  {
    question: 'Age-Related Hearing Loss (Presbycusis)',
    answer: 'As the cochlea’s hair cells deteriorate with age, the brain may compensate by “creating” phantom sounds',
  },
  {
    question: 'Noise Exposure',
    answer: 'Prolonged or sudden exposure to loud sounds (concerts, machinery) can injure inner-ear structures, triggering tinnitus',
  },
  {
    question: 'Earwax Blockage',
    answer: 'Excess cerumen can press against the eardrum or hearing instruments, causing or exacerbating tinnitus',
  },
  {
    question: 'Ototoxic Medications',
    answer: 'Certain drugs (e.g., high-dose aspirin, some antibiotics) can damage auditory pathways and induce tinnitus',
  },
  {
    question: 'Circulatory Disorders',
    answer: 'Conditions like hypertension or atherosclerosis can create turbulent blood flow in vessels near the ear, perceived as pulsatile tinnitus',
  },
];

const typesOfTinnitus = [
  {
    title: 'Subjective Tinnitus',
    description: 'Heard only by the patient; the most common form, linked to auditory-nerve activity',
  },
  {
    title: 'Objective Tinnitus',
    description: 'Rare; can be heard by an examiner with a stethoscope, often vascular or muscular in origin',
  },
  {
    title: 'Pulsatile Tinnitus',
    description: 'Rhythmic noise in time with the heartbeat, suggesting vascular involvement',
  },
  {
    title: 'Non-Pulsatile Tinnitus',
    description: 'Continuous or intermittent sounds not synchronized with pulse',
  },
];

const treatmentFaqs = [
  {
    question: 'Address Underlying Conditions',
    answer: 'Treatment of ear infections, blood-pressure control, or earwax removal can sometimes eliminate tinnitus',
  },
  {
    question: 'Hearing Aids & Sound Therapy',
    answer: 'We provide advanced hearing aids that amplify ambient sounds to mask tinnitus, and specialized sound-masking devices or apps that deliver white noise, nature sounds, or customized tinnitus-masking signals',
  },
  {
    question: 'Cognitive-Behavioral Therapy (CBT)',
    answer: 'CBT helps reframe negative thoughts about tinnitus, reducing distress and improving quality of life. Studies show CBT decreases tinnitus-related anxiety by up to 50%',
  },
  {
    question: 'Tinnitus Retraining Therapy (TRT)',
    answer: 'TRT combines directive counseling with sound enrichment to habituate the brain to tinnitus signals over 12–18 months, leading to perceptual fading of tinnitus',
  },
  {
    question: 'Pharmacological & Alternative Approaches',
    answer: 'While no drug cures tinnitus, certain medications (e.g., tricyclic antidepressants) can ease associated anxiety or sleep issues. Complementary therapies—acupuncture, mindfulness, biofeedback—may offer additional relief for some patients',
  },
];

const allFaqs = [...causesFaqs, ...treatmentFaqs];
---

<BaseLayout
  title={`${entry.data.title} – ${siteConfig.name}`}
  description={entry.data.description}
  canonicalPath="/what-is-tinnitus/"
  type="article"
  article={{
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.publishDate,
    authorName: entry.data.author,
  }}
>
  <!-- Header / Breadcrumbs -->
  <header class="relative py-12 md:py-16 overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="glass-strong rounded-3xl p-8 sm:p-10 border border-white/90 shadow-lg">
        <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs text-text-muted mb-6">
          <a href="/" class="hover:text-brand transition-colors">Home</a>
          <Icon name="chevron-right" class="w-3 h-3 text-text-muted" />
          <span>Hearing Health</span>
          <Icon name="chevron-right" class="w-3 h-3 text-text-muted" />
          <span class="text-text-primary font-medium">{entry.data.title}</span>
        </nav>

        <span class="inline-block px-3.5 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs tracking-wider uppercase mb-3">
          {entry.data.category}
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-primary tracking-tight leading-tight mb-4">
          {entry.data.title}
        </h1>
        <p class="text-lg text-secondary leading-relaxed max-w-3xl">
          {entry.data.description}
        </p>

        <div class="flex flex-wrap items-center gap-4 mt-6 pt-6 border-t border-border-subtle/80 text-xs text-text-muted">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-full bg-brand text-inverse flex items-center justify-center font-bold text-xs shadow-xs">
              SR
            </span>
            <div>
              <span class="font-semibold text-text-primary block">{entry.data.author}</span>
              <span>{entry.data.authorTitle}</span>
            </div>
          </div>
          <span class="text-border">•</span>
          <span class="font-medium text-brand bg-brand/10 px-2.5 py-0.5 rounded-full border border-brand/20">Clinical Guidance</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Article Body -->
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-6 pb-16 space-y-12">
    <!-- Featured Image in Glass Frame (Uncropped) -->
    <div class="rounded-3xl overflow-hidden glass-strong p-3 sm:p-4 border border-white/90 shadow-md max-w-lg mx-auto flex items-center justify-center bg-slate-50/50">
      <Image
        src={featuredImg}
        alt="Diagram and illustration of auditory neural pathways affected by tinnitus"
        width={512}
        height={512}
        class="w-full h-auto max-h-[420px] aspect-square object-contain rounded-2xl mx-auto"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <!-- Section 1: What is Tinnitus -->
    <section class="glass-light rounded-3xl p-8 sm:p-10 border border-white/80 shadow-md space-y-4">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
        What is Tinnitus
      </h2>
      <div class="heading-accent-bar"></div>
      <p class="text-secondary text-base sm:text-lg leading-relaxed max-w-[68ch]">
        Tinnitus is the sensation of hearing sound—commonly described as ringing, buzzing, hissing, or clicking—when no external noise is present. It can occur in one or both ears, be constant or intermittent, and vary in pitch and volume. When tinnitus persists for three months or more, it is classified as chronic and may require intervention to manage its impact on daily life.
      </p>
    </section>

    <!-- Section 2: Causes of Tinnitus (Premium FAQ) -->
    <section class="space-y-4" aria-labelledby="causes-tinnitus-heading">
      <FaqAccordion
        title="Causes of Tinnitus"
        subtitle="Explore the underlying physiological and acoustic factors contributing to phantom auditory perception."
        items={causesFaqs}
        groupName="tinnitus-causes-group"
        showControls={true}
        enableJsonLd={true}
      />
    </section>

    <!-- Section 3: Types and Symptoms (Glass Card Grid) -->
    <section class="glass-light rounded-3xl p-8 sm:p-10 border border-white/80 shadow-md space-y-6" aria-labelledby="types-symptoms-heading">
      <div>
        <h2 id="types-symptoms-heading" class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
          Types and Symptoms
        </h2>
        <p class="text-secondary text-sm mt-1">
          Tinnitus manifests in distinct auditory classifications with varying diagnostic origins.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {typesOfTinnitus.map((t, idx) => (
          <div class="glass-strong rounded-2xl p-5 border border-white/90 shadow-2xs space-y-2 glass-card-hover">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-brand/10 text-brand font-bold text-xs flex items-center justify-center">
                {idx + 1}
              </span>
              <h3 class="font-bold text-primary text-base">
                {t.title}
              </h3>
            </div>
            <p class="text-sm text-secondary leading-relaxed pl-8">
              {t.description}
            </p>
          </div>
        ))}
      </div>

      <div class="p-4 rounded-2xl bg-white/70 border border-border-subtle/80 text-sm text-secondary leading-relaxed">
        Common symptoms include difficulty concentrating, sleep disturbances, and emotional distress such as anxiety or depression when tinnitus is severe.
      </div>
    </section>

    <!-- Section 4: Understanding the Impact on Inner Ear Hair Cells -->
    <section class="glass-light rounded-3xl p-8 sm:p-10 border border-white/80 shadow-md space-y-6">
      <div class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
          Understanding the Impact on Inner Ear Hair Cells
        </h2>
        <p class="text-secondary text-base leading-relaxed">
          Inside our inner ear lies the cochlea, a spiral-shaped organ lined with tiny hair cells. These cells play a crucial role in translating sound vibrations into electrical signals that our brain interprets as sound. ​
        </p>
        <p class="text-secondary text-base leading-relaxed">
          When exposed to loud noises, especially over extended periods, these delicate hair cells can become overstimulated and damaged. Unfortunately, once damaged, these cells do not regenerate, leading to permanent hearing loss and conditions like tinnitus.
        </p>
      </div>

      <!-- Tips for Safe Earbud Use -->
      <div class="pt-6 border-t border-border-subtle/80 space-y-4">
        <h2 class="text-xl font-bold text-primary tracking-tight">
          Tips for Safe Earbud Use
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-sm text-secondary">
          <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white/60 border border-white/80">
            <span class="p-1 rounded-full bg-brand/10 text-brand mt-0.5 shrink-0">
              <Icon name="check" class="w-3.5 h-3.5" />
            </span>
            <span><strong class="text-primary font-bold">Follow the 60/60 rule:</strong> Listen at no more than 60% of maximum volume for no more than 60 minutes at a time.</span>
          </div>
          <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white/60 border border-white/80">
            <span class="p-1 rounded-full bg-brand/10 text-brand mt-0.5 shrink-0">
              <Icon name="check" class="w-3.5 h-3.5" />
            </span>
            <span><strong class="text-primary font-bold">Use noise-cancelling earbuds :</strong> These can help reduce the need to increase volume in noisy environments.</span>
          </div>
          <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white/60 border border-white/80">
            <span class="p-1 rounded-full bg-brand/10 text-brand mt-0.5 shrink-0">
              <Icon name="check" class="w-3.5 h-3.5" />
            </span>
            <span><strong class="text-primary font-bold">Take regular breaks:</strong> Give your ears time to rest and recover.</span>
          </div>
          <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white/60 border border-white/80">
            <span class="p-1 rounded-full bg-brand/10 text-brand mt-0.5 shrink-0">
              <Icon name="check" class="w-3.5 h-3.5" />
            </span>
            <span><strong class="text-primary font-bold">Stay informed:</strong> Regular hearing check-ups can help detect early signs of hearing loss.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 5: Video Section -->
    <section class="glass-light rounded-3xl p-8 sm:p-10 border border-white/80 shadow-md space-y-6" aria-labelledby="video-hearing-impact">
      <div class="space-y-2">
        <h2 id="video-hearing-impact" class="text-2xl sm:text-3xl font-extrabold text-primary">
          See how loud sounds Impact your hearing!
        </h2>
        <p class="text-secondary text-sm">
          Watch how acoustic intensity and elevated decibel levels influence fragile cochlear structures.
        </p>
      </div>

      <div class="video-facade-wrapper relative w-full aspect-video rounded-2xl overflow-hidden bg-slate-900 shadow-lg border border-border-subtle flex items-center justify-center group" data-video-id="qyFaUA14-KQ" data-video-title="See how loud sounds Impact your hearing!">
        <div class="video-placeholder absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-gradient-to-t from-black/80 via-black/40 to-black/60">
          <button
            type="button"
            class="play-video-btn w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-brand hover:bg-brand-dark text-white flex items-center justify-center shadow-2xl transition-all duration-300 transform group-hover:scale-110 cursor-pointer"
            aria-label="Play YouTube video: See how loud sounds Impact your hearing!"
          >
            <svg class="w-8 h-8 ml-1 fill-current" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </button>
          <p class="text-white text-sm sm:text-base font-semibold mt-4 drop-shadow">
            Click to Play: See how loud sounds Impact your hearing!
          </p>
          <a
            href="https://www.youtube.com/watch?v=qyFaUA14-KQ"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-slate-300 hover:text-white underline mt-2"
          >
            Watch directly on YouTube
          </a>
        </div>
        <noscript>
          <iframe
            class="w-full h-full absolute inset-0"
            src="https://www.youtube-nocookie.com/embed/qyFaUA14-KQ"
            title="See how loud sounds Impact your hearing!"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </noscript>
      </div>
    </section>

    <!-- Section 6: Diagnosis and Evaluation -->
    <section class="glass-light rounded-3xl p-8 sm:p-10 border border-white/80 shadow-md space-y-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
        Diagnosis and Evaluation
      </h2>
      <p class="text-secondary text-base">
        A thorough evaluation by an audiologist includes :
      </p>

      <div class="space-y-3">
        <div class="p-4 rounded-2xl bg-white/70 border border-border-subtle/80 flex items-start gap-3">
          <span class="w-7 h-7 rounded-full bg-brand/10 text-brand font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">1</span>
          <p class="text-sm sm:text-base text-secondary font-medium">Medical & Otoscopic Exam: To detect earwax, infections, or structural issues.</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/70 border border-border-subtle/80 flex items-start gap-3">
          <span class="w-7 h-7 rounded-full bg-brand/10 text-brand font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">2</span>
          <p class="text-sm sm:text-base text-secondary font-medium">Pure-Tone & Speech Audiometry: To assess hearing thresholds and speech-understanding ability</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/70 border border-border-subtle/80 flex items-start gap-3">
          <span class="w-7 h-7 rounded-full bg-brand/10 text-brand font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">3</span>
          <p class="text-sm sm:text-base text-secondary font-medium">Tympanometry: To evaluate middle-ear pressure and eardrum mobility</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/70 border border-border-subtle/80 flex items-start gap-3">
          <span class="w-7 h-7 rounded-full bg-brand/10 text-brand font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">4</span>
          <p class="text-sm sm:text-base text-secondary font-medium">Otoacoustic Emissions (OAE): To measure cochlear hair-cell function</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/70 border border-border-subtle/80 flex items-start gap-3">
          <span class="w-7 h-7 rounded-full bg-brand/10 text-brand font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">5</span>
          <p class="text-sm sm:text-base text-secondary font-medium">Questionnaires & Tinnitus Matching: To quantify tinnitus loudness, pitch, and handicap .</p>
        </div>
      </div>
    </section>

    <!-- Section 7: Treatment Options (Premium FAQ) -->
    <section class="space-y-4" aria-labelledby="treatment-options-heading">
      <FaqAccordion
        title="Treatment Options"
        subtitle="Clinical sound therapy, habituation protocols, and customized medical strategies."
        items={treatmentFaqs}
        groupName="tinnitus-treatment-group"
        showControls={true}
      />
    </section>

    <!-- Section 8: Consultation CTA Card (Glass Dark) -->
    <div class="mt-14 p-8 sm:p-10 rounded-3xl glass-dark border border-white/20 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-3">
        <h2 class="text-2xl font-bold text-white tracking-tight">
          Concerned About Your Hearing?
        </h2>
        <p class="text-slate-200 text-sm max-w-xl leading-relaxed">
          If you've experienced ringing in your ears, difficulty understanding conversations, or other hearing concerns, our clinic is here to help. Schedule a consultation with our audiologists to assess your hearing health and explore personalized solutions.
        </p>
      </div>
      <div class="shrink-0 flex flex-col sm:flex-row gap-3 w-full md:w-auto">
        <a
          href="/appointment-form/"
          class="btn-primary"
        >
          Schedule Now
        </a>
        <a
          href={`tel:${siteConfig.clinics.mississauga.phoneRaw}`}
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-sm transition-colors text-center border border-white/20"
        >
          Call (905) 232-7860
        </a>
      </div>
    </div>
  </article>

  <script>
    function initVideoFacades() {
      const wrappers = document.querySelectorAll('.video-facade-wrapper');
      wrappers.forEach((el) => {
        const wrapper = el as HTMLElement;
        const videoId = wrapper.dataset.videoId;
        const videoTitle = wrapper.dataset.videoTitle || 'YouTube Video';
        if (!videoId) return;

        function loadVideo(autoplay = false) {
          if (wrapper.querySelector('iframe')) return;
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=${autoplay ? 1 : 0}`;
          iframe.title = videoTitle;
          iframe.className = 'w-full h-full absolute inset-0';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          iframe.loading = 'lazy';

          const placeholder = wrapper.querySelector('.video-placeholder');
          if (placeholder) placeholder.remove();
          wrapper.appendChild(iframe);
        }

        const btn = wrapper.querySelector('.play-video-btn');
        btn?.addEventListener('click', () => loadVideo(true));
      });
    }

    initVideoFacades();
    document.addEventListener('astro:page-load', initVideoFacades);
  </script>
</BaseLayout>
