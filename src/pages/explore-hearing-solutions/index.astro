---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import BrandStrip from '../../components/BrandStrip.astro';
import { siteConfig } from '../../data/site';
import {
  exploreSolutionsHeroImg,
  exploreNaidaBteImg,
  exploreRicDeviceImg,
  exploreSlimProfileImg,
  exploreSlimPairImg,
  exploreIteAidImg,
  exploreItcAidImg,
  exploreCicAidImg,
  exploreCicDiagramImg,
  exploreIicDiagramImg,
  exploreFeatureComfortImg,
  exploreFeatureClarityImg,
  exploreFeatureDurabilityImg,
  exploreFeatureEqualizerImg,
  exploreMusicianBannerImg,
  exploreEarplugsProtection,
  exploreNoiseProtectionImg,
  exploreTypesOfEarplugsImg,
  exploreSleepingEarplugsImg,
  exploreCrosDiagramImg,
  exploreBiCrosDiagramImg
} from '../../assets';
---

<BaseLayout
  title={`Explore Personalized Hearing Aid Options – ${siteConfig.name}`}
  description="Discover advanced digital hearing aids: BTE, RIC, ITE, ITC, CIC, IIC, CROS/BiCROS solutions, and custom musician and swimming ear protection."
  canonicalPath="/explore-hearing-solutions/"
>
  <!-- Page Header with Background Image & Adjusted Transparency Overlay -->
  <header class="relative py-10 md:py-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-slate-950">
        <!-- Background Hero Image -->
        <Image
          src={exploreSolutionsHeroImg}
          alt="Audiologist and patient in clinical hearing test booth"
          width={1440}
          height={644}
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Dark Gradient Overlay for High Text Legibility & Visual Clarity -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-900/60 z-0"></div>

        <!-- Content Overlay -->
        <div class="relative z-10 p-8 sm:p-12 lg:p-14">
          <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs text-slate-300 mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />
            <span class="text-white font-medium">Hearing Solutions</span>
          </nav>

          <div class="max-w-3xl space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-full bg-brand/20 backdrop-blur-md text-sky-300 border border-sky-400/30 font-bold text-xs tracking-wider uppercase">
              Not Sure Where to Start? We've Got You
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              Explore Your Personalized Hearing Aid Options
            </h1>
            <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl">
              Your hearing needs are unique—and your hearing aids should be too. We guide you through the best styles based on your lifestyle, acoustic prescription, and aesthetic preferences.
            </p>
          </div>

          <!-- Quick Navigation Buttons & Anchors -->
          <div class="pt-8 space-y-4">
            <!-- Primary Type Jump Buttons (Matching Reference) -->
            <div class="flex flex-wrap gap-3">
              <a
                href="#bte"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-white/40 bg-white/15 hover:bg-white/25 text-white font-semibold text-sm backdrop-blur-md transition-all shadow-sm hover:shadow-md hover:border-white/70 hover:-translate-y-0.5"
              >
                <span>Visible hearing Aids</span>
                <span class="text-sky-300 font-bold">↓</span>
              </a>
              <a
                href="#invisible"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-white/40 bg-white/15 hover:bg-white/25 text-white font-semibold text-sm backdrop-blur-md transition-all shadow-sm hover:shadow-md hover:border-white/70 hover:-translate-y-0.5"
              >
                <span>Invisible hearing aids</span>
                <span class="text-sky-300 font-bold">↓</span>
              </a>
            </div>

            <!-- Detailed Anchor Pills -->
            <div class="flex flex-wrap gap-2 pt-1">
              <a href="#bte" class="px-3.5 py-1.5 rounded-full bg-slate-900/60 hover:bg-white/20 border border-white/25 text-xs font-medium text-slate-200 hover:text-white transition-all backdrop-blur-md">
                Behind-the-Ear (BTE)
              </a>
              <a href="#ric" class="px-3.5 py-1.5 rounded-full bg-slate-900/60 hover:bg-white/20 border border-white/25 text-xs font-medium text-slate-200 hover:text-white transition-all backdrop-blur-md">
                Receiver-in-Canal (RIC)
              </a>
              <a href="#ite" class="px-3.5 py-1.5 rounded-full bg-slate-900/60 hover:bg-white/20 border border-white/25 text-xs font-medium text-slate-200 hover:text-white transition-all backdrop-blur-md">
                In-the-Ear (ITE & ITC)
              </a>
              <a href="#invisible" class="px-3.5 py-1.5 rounded-full bg-slate-900/60 hover:bg-white/20 border border-white/25 text-xs font-medium text-slate-200 hover:text-white transition-all backdrop-blur-md">
                Invisible (IIC & CIC)
              </a>
              <a href="#cros" class="px-3.5 py-1.5 rounded-full bg-slate-900/60 hover:bg-white/20 border border-white/25 text-xs font-medium text-slate-200 hover:text-white transition-all backdrop-blur-md">
                CROS & BiCROS
              </a>
              <a href="#custom-protection" class="px-3.5 py-1.5 rounded-full bg-slate-900/60 hover:bg-white/20 border border-white/25 text-xs font-medium text-slate-200 hover:text-white transition-all backdrop-blur-md">
                Custom Protection
              </a>
              <a href="#comparison" class="px-3.5 py-1.5 rounded-full bg-slate-900/60 hover:bg-white/20 border border-white/25 text-xs font-medium text-slate-200 hover:text-white transition-all backdrop-blur-md">
                Comparison Table
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Solutions Sections -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-16 space-y-16">
    <!-- 1. BTE Section -->
    <section id="bte" class="scroll-mt-28 glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5">
          <div class="rounded-3xl overflow-hidden glass-strong border border-white/90 p-6 flex items-center justify-center shadow-xs">
            <Image src={exploreNaidaBteImg} alt="Phonak Naida Behind-the-Ear (BTE) Digital Hearing Aid" width={768} height={768} class="max-h-72 w-auto object-contain" loading="eager" fetchpriority="high" decoding="async" />
          </div>
        </div>

        <div class="lg:col-span-7 space-y-5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-block px-3 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
              High Power & Durability
            </span>
            <span class="inline-block px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs">
              Mild to profound
            </span>
          </div>
          <h2 class="text-3xl font-extrabold text-primary tracking-tight">
            Behind-the-Ear (BTE)
          </h2>
          <p class="text-secondary leading-relaxed">
            BTE hearing aids are worn comfortably behind the ear, with a clear tube connecting the device to an earpiece inside your ear canal. These are ideal for a wide range of hearing loss, from mild to profound, and are known for their durability and ease of use. They are a great choice for users who need more power or want a larger device that's easier to handle. Modern BTE models are sleek, lightweight, and compatible with advanced features like Bluetooth connectivity.
          </p>

          <h3 class="text-xs font-bold uppercase tracking-wider text-text-muted mt-2">Key Features</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <div class="w-10 h-10 rounded-xl bg-brand/10 p-2 mb-2 flex items-center justify-center">
                <Image src={exploreFeatureComfortImg} alt="Comfort icon" width={32} height={32} class="w-6 h-6 object-contain" />
              </div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-text-muted block mb-0.5">Comfort</h4>
              <h5 class="text-xs font-bold text-brand uppercase block mb-1">Open-Fit Option</h5>
              <p class="text-xs text-secondary leading-relaxed">
                Lets natural low-frequency sounds enter unamplified while boosting high frequencies-ideal for those with good low-frequency thresholds and high-frequency loss
              </p>
            </div>
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <div class="w-10 h-10 rounded-xl bg-brand/10 p-2 mb-2 flex items-center justify-center">
                <Image src={exploreFeatureEqualizerImg} alt="Equalizer icon" width={32} height={32} class="w-6 h-6 object-contain" />
              </div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-text-muted block mb-0.5">Flexibility</h4>
              <h5 class="text-xs font-bold text-brand uppercase block mb-1">Telecoil Compatibility</h5>
              <p class="text-xs text-secondary leading-relaxed">
                Built-in T-coil picks up loop-system signals in theaters, places of worship, and other venues-reduces background noise dramatically
              </p>
            </div>
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <div class="w-10 h-10 rounded-xl bg-brand/10 p-2 mb-2 flex items-center justify-center">
                <Image src={exploreFeatureDurabilityImg} alt="Durability icon" width={32} height={32} class="w-6 h-6 object-contain" />
              </div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-text-muted block mb-0.5">Durability</h4>
              <h5 class="text-xs font-bold text-brand uppercase block mb-1">IP68 Water / Dust Resistance</h5>
              <p class="text-xs text-secondary leading-relaxed">
                Selected BTEs withstand sweat, rain, and brief submersion, suiting active lifestyles and challenging environments
              </p>
            </div>
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <div class="w-10 h-10 rounded-xl bg-brand/10 p-2 mb-2 flex items-center justify-center">
                <Image src={exploreFeatureClarityImg} alt="Clarity icon" width={32} height={32} class="w-6 h-6 object-contain" />
              </div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-text-muted block mb-0.5">Strength</h4>
              <h5 class="text-xs font-bold text-brand uppercase block mb-1">High-Power Amplification</h5>
              <p class="text-xs text-secondary leading-relaxed">
                Large casing supports severe to profound losses with up to 85 dB gain and advanced noise-reduction algorithms
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. RIC Section -->
    <section id="ric" class="scroll-mt-28 glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-5 order-2 lg:order-1">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-block px-3 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
              Discreet & Popular
            </span>
            <span class="inline-block px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs">
              Mild to severe
            </span>
          </div>
          <h2 class="text-3xl font-extrabold text-primary tracking-tight">
            Receiver-in-Canal (RIC / RITE)
          </h2>
          <p class="text-secondary leading-relaxed">
            RIC devices are a discreet and modern option that places the receiver (or speaker) directly in the ear canal while the rest of the device sits comfortably behind the ear. This design delivers clear, natural sound and minimizes feedback or distortion. RIC hearing aids are suitable for mild to severe hearing loss and are highly customizable. Their small, lightweight design makes them nearly invisible, offering both comfort and aesthetic appeal.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <span class="text-xs font-bold uppercase tracking-wider text-text-muted block mb-0.5">Discretion</span>
              <h3 class="text-xs font-bold text-brand uppercase block mb-1">Slim Profile</h3>
              <p class="text-xs text-secondary leading-relaxed">
                Minimizes occlusion and wind noise by placing the speaker in‑canal on a thin wire—enhances comfort and natural sound
              </p>
            </div>
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <span class="text-xs font-bold uppercase tracking-wider text-text-muted block mb-0.5">Acoustics</span>
              <h3 class="text-xs font-bold text-brand uppercase block mb-1">Open‑Fit Capability</h3>
              <p class="text-xs text-secondary leading-relaxed">
                Combination of behind‑ear processor and open‑ear dome preserves low frequencies while amplifying highs
              </p>
            </div>
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <span class="text-xs font-bold text-brand uppercase block mb-1">High‑Frequency Emphasis</span>
              <p class="text-xs text-secondary leading-relaxed">
                Tailored for sloping, high‑frequency losses common in age‑related hearing decline
              </p>
            </div>
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <span class="text-xs font-bold uppercase tracking-wider text-text-muted block mb-0.5">Enhanced Features</span>
              <h3 class="text-xs font-bold text-brand uppercase block mb-1">Bluetooth & App Control</h3>
              <p class="text-xs text-secondary leading-relaxed">
                Lightweight design integrates streaming and remote adjustments—suitable for mild to severe loss with a discreet footprint
              </p>
            </div>
          </div>

          <!-- Phonak Slim Showcase -->
          <div class="grid grid-cols-2 gap-4 pt-3">
            <div class="rounded-2xl glass-strong border border-white/90 p-3 flex flex-col items-center text-center shadow-2xs">
              <Image src={exploreSlimPairImg} alt="Phonak Slim pair with receiver" width={280} height={280} class="max-h-28 w-auto object-contain mb-2" loading="lazy" />
              <span class="text-[11px] font-semibold text-text-muted">Phonak Slim Pair with Receiver</span>
            </div>
            <div class="rounded-2xl glass-strong border border-white/90 p-3 flex flex-col items-center text-center shadow-2xs">
              <Image src={exploreSlimProfileImg} alt="Phonak Slim ergonomic profile" width={280} height={280} class="max-h-28 w-auto object-contain mb-2" loading="lazy" />
              <span class="text-[11px] font-semibold text-text-muted">Contoured Ergonomic Profile</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 order-1 lg:order-2">
          <div class="rounded-3xl overflow-hidden glass-strong border border-white/90 p-6 flex items-center justify-center shadow-xs">
            <Image src={exploreRicDeviceImg} alt="Receiver-in-Canal (RIC) Hearing Device" width={768} height={768} class="max-h-72 w-auto object-contain" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- 3. ITE & ITC Section -->
    <section id="ite" class="scroll-mt-28 glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5">
          <div class="rounded-3xl overflow-hidden glass-strong border border-white/90 p-6 flex items-center justify-center shadow-xs">
            <Image src={exploreIteAidImg} alt="In-the-Ear (ITE) Custom Hearing Aid" width={618} height={618} class="max-h-72 w-auto object-contain" loading="lazy" />
          </div>
        </div>

        <div class="lg:col-span-7 space-y-5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-block px-3 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
              Custom Molded Comfort
            </span>
            <span class="inline-block px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs">
              Mild to severe
            </span>
          </div>
          <h2 class="text-3xl font-extrabold text-primary tracking-tight">
            In‑the‑Ear (ITE) & In‑the‑Canal (ITC)
          </h2>
          <p class="text-secondary leading-relaxed">
            ITE hearing aids are custom-made to fit snugly inside the outer portion of your ear. They are a great option for individuals looking for a balance between visibility, ease of handling, and advanced features.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <span class="text-xs font-bold text-brand uppercase block mb-1">Easy Handling & Controls</span>
              <p class="text-xs text-secondary leading-relaxed">
                Larger shell accommodates volume wheels and program buttons—perfect for users with dexterity or vision challenges
              </p>
            </div>
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <span class="text-xs font-bold text-brand uppercase block mb-1">Advanced Features in Shell</span>
              <p class="text-xs text-secondary leading-relaxed">
                Space for directional microphones, telecoil, and tinnitus-masking functions within the shell
              </p>
            </div>
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <span class="text-xs font-bold text-brand uppercase block mb-1">Custom Fit & Comfort</span>
              <p class="text-xs text-secondary leading-relaxed">
                Personalized concha design reduces feedback and enhances sound localization
              </p>
            </div>
            <div class="p-4 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
              <span class="text-xs font-bold text-brand uppercase block mb-1">Robust Amplification</span>
              <p class="text-xs text-secondary leading-relaxed">
                Suited for mild through severe loss with enough room for stronger receivers and noise-management circuitry
              </p>
            </div>
          </div>

          <!-- In-the-Canal (ITC) Specific Details -->
          <div class="mt-6 p-6 rounded-2xl glass-strong border border-white/90 grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
            <div class="md:col-span-8 space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold text-primary">In‑the‑Canal (ITC)</h3>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand/10 text-brand">Partially Visible</span>
              </div>
              <p class="text-xs text-secondary leading-relaxed">
                ITC hearing aids are designed to fit partly in the ear canal, making them less visible than larger models, but still easy to handle.
              </p>
              <ul class="space-y-2 text-xs text-secondary">
                <li class="flex items-start gap-1.5">
                  <span class="text-brand font-bold">•</span>
                  <span><strong class="text-primary font-bold">Ease of Handling:</strong> The larger size of ITC devices makes them easier to handle, insert, and remove, which can be beneficial for users with dexterity concerns.</span>
                </li>
                <li class="flex items-start gap-1.5">
                  <span class="text-brand font-bold">•</span>
                  <span><strong class="text-primary font-bold">Discreet Appearance:</strong> While slightly more visible than CIC models, ITC aids still offer a discreet appearance, fitting snugly within the ear canal.</span>
                </li>
                <li class="flex items-start gap-1.5">
                  <span class="text-brand font-bold">•</span>
                  <span><strong class="text-primary font-bold">Custom-Molded Fit:</strong> Like CIC devices, ITC hearing aids are custom-molded to the user's ear, providing comfort and a secure fit.</span>
                </li>
                <li class="flex items-start gap-1.5">
                  <span class="text-brand font-bold">•</span>
                  <span><strong class="text-primary font-bold">On-Board Controls:</strong> The slightly larger size of ITC aids allows for additional features, such as manual volume controls and directional microphones, enhancing user experience.</span>
                </li>
              </ul>
            </div>
            <div class="md:col-span-4 flex flex-col items-center justify-center p-4 rounded-2xl glass-light border border-white/80 text-center">
              <Image src={exploreItcAidImg} alt="In-the-Canal (ITC) Custom Hearing Aid in ear" width={320} height={300} class="max-h-44 w-auto object-contain mb-2 rounded-2xl" loading="lazy" />
              <span class="text-[11px] font-semibold text-text-muted">In-Canal Anatomy Fit</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Invisible Hearing Aids (IIC & CIC) -->
    <section id="invisible" class="scroll-mt-28 glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md space-y-10">
      <div class="text-center max-w-3xl mx-auto space-y-2">
        <span class="inline-block px-3.5 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
          Maximum Discretion
        </span>
        <h2 class="text-3xl font-extrabold text-primary tracking-tight">
          Invisible Hearing Aids
        </h2>
        <p class="text-secondary text-sm">
          Custom-molded to fit deep within the ear canal, combining high fidelity with ultimate cosmetic discretion.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Invisible-in-Canal (IIC) Card -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="rounded-2xl overflow-hidden flex items-center justify-center">
              <Image
                src={exploreIicDiagramImg}
                alt="Invisible-in-Canal (IIC) Deep Ear Canal Placement Medical Diagram"
                width={800}
                height={800}
                class="w-full h-auto max-h-72 object-contain rounded-2xl shadow-sm"
                loading="lazy"
              />
            </div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand">Deep Ear Canal Placement</span>
            <h3 class="text-2xl font-bold text-primary">Invisible-in-Canal (IIC)</h3>
            <p class="text-sm text-secondary leading-relaxed">
              IIC hearing aids are the smallest and most discreet option available, designed to sit deep inside the ear canal. These are perfect for individuals with mild to moderate hearing loss who want an entirely invisible solution. Custom-fitted for maximum comfort, they offer excellent sound quality and natural hearing experiences. IIC devices are a fantastic choice for those prioritizing discretion and aesthetics in their hearing aids.
            </p>
            <div class="space-y-3 pt-2">
              <div class="p-3.5 rounded-xl bg-white/70 border border-border-subtle/80">
                <span class="font-bold text-xs text-primary block mb-0.5">Virtually Invisible</span>
                <p class="text-xs text-secondary">
                  IIC hearing aids are custom-molded to fit deep within the second bend of the ear canal, rendering them virtually invisible when worn. This placement ensures that the device remains out of sight, catering to users who prioritize aesthetics and discretion.
                </p>
              </div>
              <div class="p-3.5 rounded-xl bg-white/70 border border-border-subtle/80">
                <span class="font-bold text-xs text-primary block mb-0.5">Compatibility with Headgear and Telephones</span>
                <p class="text-xs text-secondary">
                  Due to their deep placement within the ear canal, IIC hearing aids do not interfere with the use of telephones, headphones, or other headgear. This feature is particularly beneficial for individuals with active lifestyles or those who frequently use such accessories.
                </p>
              </div>
              <div class="p-3.5 rounded-xl bg-white/70 border border-border-subtle/80">
                <span class="font-bold text-xs text-primary block mb-0.5">Natural Sound Quality & Localization</span>
                <p class="text-xs text-secondary">
                  Positioned deep in the ear canal, IIC devices utilize the ear’s natural acoustics to deliver a more authentic sound experience. This placement allows for better sound localization and reduces the sensation of one’s own voice sounding amplified or “boomy,” a common issue known as the occlusion effect.
                </p>
              </div>
              <div class="p-3.5 rounded-xl bg-white/70 border border-border-subtle/80">
                <span class="font-bold text-xs text-primary block mb-0.5">Custom Fit</span>
                <p class="text-xs text-secondary">
