      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- CROS Card -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="rounded-2xl overflow-hidden glass-light p-4 flex items-center justify-center border border-white/80">
