---
import { Image } from 'astro:assets';
import {
  impactHeroImg,
  impactEmotionalImg,
  impactCognitiveImg,
  impactSocialConnectionsImg,
  impactMythsFactsImg
} from '../../assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Icon from '../../components/Icon.astro';
import { getEntry, render } from 'astro:content';
import { siteConfig } from '../../data/site';

const entry = await getEntry('hearingHealth', 'the-impact-of-untreated-hearing-loss');
if (!entry) {
  throw new Error('Content entry not found');
}
const { Content } = await render(entry);

const mythsFaqs = [
  {
    question: "Only old people lose their hearing",
    answer: "While prevalence increases with age, 13% of U.S. adults aged 18+ report hearing difficulties, and up to 63% of Canadian men aged 40–79 have measurable loss despite not noticing it.",
    mythPill: true,
    factPill: true,
  },
  {
    question: "Mild hearing loss isn’t a big deal",
    answer: "Even a mild hearing loss can significantly strain your brain as it tries to fill in missing sounds and speech cues. This constant mental effort can cause fatigue, reduce your ability to concentrate, and increase emotional stress.",
    mythPill: true,
    factPill: true,
  },
  {
    question: "Hearing aids are bulky and ineffective",
    answer: "Modern hearing aids are discreet, smartphone-compatible devices that can reduce depression and slow cognitive decline by up to 50%.",
    mythPill: true,
    factPill: true,
  },
  {
    question: "If I ignore it, it will go away",
    answer: "Hearing loss rarely improves on its own. Delaying treatment allows brain changes and social withdrawal to worsen, increasing risks of dementia, depression, and falls.",
    mythPill: true,
    factPill: true,
  },
];
---

<BaseLayout
  title={`The Hidden Cost of Ignoring Hearing Loss – ${siteConfig.name}`}
  description={entry.data.description}
  canonicalPath="/the-impact-of-untreated-hearing-loss/"
  type="article"
  article={{
    headline: "The Hidden Cost of Ignoring Hearing Loss",
    description: entry.data.description,
    datePublished: entry.data.publishDate,
    authorName: entry.data.author,
  }}
>
  <!-- Page Header with Background Image & Adjusted Transparency Overlay -->
  <header class="relative py-10 md:py-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-slate-950">
        <!-- Background Hero Image -->
        <Image
          src={impactHeroImg}
          alt="Senior man reflecting on the emotional and social impact of untreated hearing loss"
          width={1440}
          height={726}
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Dark Gradient Overlay for Maximum Text Visibility & Rich Contrast -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-900/60 z-0"></div>

        <!-- Content Overlay -->
        <div class="relative z-10 p-8 sm:p-12 lg:p-14 reveal-down">
          <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs text-slate-300 mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />
            <span class="text-slate-300">Hearing Health</span>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />
            <span class="text-white font-medium">{entry.data.title}</span>
          </nav>

          <div class="max-w-3xl space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-full bg-brand/20 backdrop-blur-md text-sky-300 border border-sky-400/30 font-bold text-xs tracking-wider uppercase">
              {entry.data.category}
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              The Hidden Cost of Ignoring Hearing Loss
            </h1>
            <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl">
              {entry.data.description}
            </p>

            <div class="flex flex-wrap items-center gap-4 mt-6 pt-6 border-t border-white/20 text-xs text-slate-300">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-full bg-brand text-inverse flex items-center justify-center font-bold text-xs shadow-xs">
                  SR
                </span>
                <div>
                  <span class="font-semibold text-white block">{entry.data.author}</span>
                  <span>{entry.data.authorTitle}</span>
                </div>
              </div>
              <span class="text-slate-500">•</span>
              <span class="font-medium text-emerald-300 bg-emerald-500/20 px-2 py-0.5 rounded-full border border-emerald-400/30">Clinically Reviewed</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Article Body -->
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-6 pb-16">
    <!-- Article Content in 68ch Reading Column -->
    <div class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md reveal-up">
      <div class="reading-column prose-clinical">
        <Content />
      </div>

      <!-- Visual Showcases in Glass Frames -->
      <div class="mt-10 pt-8 border-t border-border-subtle/80 space-y-8 max-w-2xl mx-auto">
        <!-- Emotional & Mental Well-Being -->
        <div class="rounded-2xl overflow-hidden glass-strong p-4 border border-white/90 shadow-sm flex flex-col items-center reveal-scale">
          <Image
            src={impactEmotionalImg}
            alt="Emotional and mental well-being in personal relationships and hearing health"
            width={800}
            height={800}
            class="w-full h-auto max-h-72 object-contain rounded-xl"
            loading="lazy"
          />
          <p class="text-xs text-text-muted text-center mt-2.5 font-medium">
            Restoring emotional well-being and reducing isolation through proactive hearing care
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <!-- Cognitive Health Visualization -->
          <div class="rounded-2xl overflow-hidden glass-strong p-4 border border-white/90 shadow-sm flex flex-col items-center justify-between text-center reveal-left reveal-delay-100">
            <div class="w-full rounded-xl overflow-hidden aspect-16/9 shadow-xs bg-slate-900">
              <Image
                src={impactCognitiveImg}
                alt="3D medical visualization of human brain auditory cortex and neural pathway"
                width={800}
                height={450}
                class="w-full h-full object-cover rounded-xl"
                loading="lazy"
              />
            </div>
            <p class="text-xs text-text-muted text-center mt-3 font-semibold">
              Cognitive Health & Auditory Processing Pathway
            </p>
          </div>

          <!-- Social Connections Photography -->
          <div class="rounded-2xl overflow-hidden glass-strong p-4 border border-white/90 shadow-sm flex flex-col items-center justify-between text-center reveal-right reveal-delay-200">
            <div class="w-full rounded-2xl overflow-hidden aspect-16/9 shadow-xs">
              <Image
                src={impactSocialConnectionsImg}
                alt="Active family and seniors enjoying dinner conversation together"
                width={800}
                height={450}
                class="w-full h-full object-cover rounded-2xl"
                loading="lazy"
              />
            </div>
            <p class="text-xs text-text-muted text-center mt-3 font-semibold">
              Preserving Social Connections & Communication Confidence
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Myths vs Facts Premium Section -->
    <section class="mt-12" aria-labelledby="myths-table-heading">
      <div class="mb-8 rounded-3xl overflow-hidden glass-strong p-3 sm:p-4 border border-white/90 shadow-md max-w-2xl mx-auto flex flex-col items-center reveal-down">
        <div class="w-full rounded-2xl overflow-hidden aspect-16/9 shadow-xs">
          <Image
            src={impactMythsFactsImg}
            alt="Audiology specialist reviewing audiogram results with clinical ear model"
            width={960}
            height={540}
            class="w-full h-full object-cover rounded-2xl"
            loading="lazy"
          />
        </div>
        <p class="text-xs text-text-muted text-center mt-2.5 font-medium">
          Evidence-based audiological assessments separate hearing loss facts from common misconceptions.
        </p>
      </div>
      <div class="reveal-up">
        <FaqAccordion
          title="Common Myths About Hearing Loss"
          subtitle="Separating widespread hearing misconceptions from evidence-based clinical facts."
          items={mythsFaqs}
          groupName="myths-group"
          showControls={true}
          enableJsonLd={true}
        />
      </div>
    </section>

    <!-- Consultation CTA Card (Glass Dark with Photographic Depth) -->
    <div class="relative mt-14 p-8 sm:p-12 rounded-3xl glass-dark border border-white/20 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-8 overflow-hidden reveal-scale">
      <!-- Background Image with Gradient Overlay -->
      <div class="absolute inset-0 pointer-events-none">
        <Image
          src={impactEmotionalImg}
          alt="Emotional well-being and hearing health"
          width={1000}
          height={600}
          class="w-full h-full object-cover opacity-15 mix-blend-luminosity scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-primary/95 via-primary/85 to-primary/90"></div>
      </div>

      <div class="relative z-10 space-y-3">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Take Control of Your Hearing Health
        </h2>
        <p class="text-slate-200 text-sm sm:text-base max-w-xl leading-relaxed">
          Ignoring hearing loss carries hidden costs—for your mind, mood, relationships, and safety. At HearMaxx, Dr. Sheeraz Rahim provides a painless hearing evaluation and personalized treatment plan to help you reconnect with life’s sounds.
        </p>
      </div>
      <div class="relative z-10 shrink-0 flex flex-col sm:flex-row gap-3 w-full md:w-auto">
        <a
          href="/appointment-form/"
          class="btn-primary shadow-lg shadow-brand/25 text-center"
        >
          Request Assessment
        </a>
        <a
          href={`tel:${siteConfig.clinics.mississauga.phoneRaw}`}
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-sm transition-colors text-center border border-white/20"
        >
          Call (905) 232-7860
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
