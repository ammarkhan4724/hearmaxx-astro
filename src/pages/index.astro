---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandStrip from '../components/BrandStrip.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../data/site';
import heroImg from '../assets/images/hero-consultation.webp';
import specialistImg from '../assets/images/sheeraz-rahim-specialist.webp';
---

<BaseLayout
  title={`${siteConfig.name} – Ultimate Hearing Solutions`}
  description={siteConfig.description}
  canonicalPath="/"
  type="home"
>
  <!-- Hero Section -->
  <section class="relative py-12 md:py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Text in Glass Strong Container -->
        <div class="lg:col-span-7">
          <div class="glass-strong rounded-3xl p-8 sm:p-12 border border-white/90 shadow-xl space-y-6">
            <!-- Floating glass rating badge -->
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/90 border border-white/90 shadow-2xs text-xs text-secondary">
              <div class="flex text-amber-500 gap-0.5" role="img" aria-label="5 star rating">
                <Icon name="star" class="w-3.5 h-3.5 fill-current" />
                <Icon name="star" class="w-3.5 h-3.5 fill-current" />
                <Icon name="star" class="w-3.5 h-3.5 fill-current" />
                <Icon name="star" class="w-3.5 h-3.5 fill-current" />
                <Icon name="star" class="w-3.5 h-3.5 fill-current" />
              </div>
              <span class="font-bold text-primary">{siteConfig.ratingLine}</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-primary tracking-tight leading-[1.12]">
              Your hearing, <br />
              <span class="text-brand">Our priority.</span>
            </h1>

            <p class="text-xl sm:text-2xl font-bold text-primary">
              Experience Clearer Conversations with Us
            </p>

            <p class="text-base sm:text-lg text-secondary max-w-xl leading-relaxed">
              {siteConfig.description}
            </p>

            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 pt-2">
              <a
                href="/appointment-form/"
                class="btn-primary"
              >
                <Icon name="calendar" class="w-5 h-5" />
                <span>Book Free Consultation</span>
              </a>
              <a
                href="/explore-hearing-solutions/"
                class="btn-glass"
              >
                <span>Explore Solutions</span>
                <Icon name="chevron-right" class="w-4 h-4" />
              </a>
            </div>

            <!-- Trust Badges -->
            <div class="pt-6 border-t border-border-subtle/80 flex flex-wrap items-center gap-6 text-xs text-text-muted font-medium">
              <div class="flex items-center gap-2">
                <span class="p-1 rounded-full bg-emerald-100 text-emerald-800">
                  <Icon name="check" class="w-3.5 h-3.5" />
                </span>
                <span>Free Hearing Evaluation</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="p-1 rounded-full bg-emerald-100 text-emerald-800">
                  <Icon name="check" class="w-3.5 h-3.5" />
                </span>
                <span>No Doctor's Referral Needed</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="p-1 rounded-full bg-emerald-100 text-emerald-800">
                  <Icon name="check" class="w-3.5 h-3.5" />
                </span>
                <span>{siteConfig.specialist.experience}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Hero Image in Glass Frame -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden glass-light p-2 border border-white/90 shadow-2xl aspect-4/3 sm:aspect-5/4">
            <Image
              src={heroImg}
              alt="Hearing care specialist conducting patient consultation at HearMaxx"
              width={600}
              height={480}
              class="w-full h-full object-cover rounded-2xl"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <div class="absolute inset-x-4 bottom-4 p-4 rounded-2xl glass-strong border border-white/95 text-xs shadow-lg">
              <div class="flex items-center justify-between">
                <div>
                  <span class="font-extrabold text-primary block">Mississauga & York Clinics</span>
                  <span class="text-secondary text-[11px]">Walk-ins welcome & appointments available</span>
                </div>
                <a href="/find-our-clinics/" class="text-brand font-bold hover:underline shrink-0 pl-2">
                  View Map →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Why Hearing Matters -->
  <section class="py-16" aria-labelledby="why-hearing-matters">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
        <span class="inline-block px-3.5 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs tracking-wider uppercase">
          Auditory Wellness
        </span>
        <h2 id="why-hearing-matters" class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight">
          Are You Missing Out on the Sounds That Matter Most?
        </h2>
        <p class="text-secondary text-base">
          Hearing connects you to every conversation, family celebration, and ambient detail.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="glass-light rounded-3xl p-8 border border-white/80 shadow-md flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center font-extrabold text-base shadow-2xs">
              01
            </div>
            <h3 class="text-xl font-bold text-primary">
              Why is Hearing Vital for Work & Learning?
            </h3>
            <p class="text-sm text-secondary leading-relaxed">
              Hearing loss often develops gradually, making it difficult to notice until it significantly impacts daily life. Regular screenings can identify subtle changes early, allowing for timely intervention and better management.
            </p>
          </div>
          <div class="pt-6">
            <a href="/appointment-form/" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand hover:text-brand-dark">
              <span>Get Started</span>
              <Icon name="chevron-right" class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="glass-light rounded-3xl p-8 border border-white/80 shadow-md flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center font-extrabold text-base shadow-2xs">
              02
            </div>
            <h3 class="text-xl font-bold text-primary">
              Why Does Clear Hearing Reduce Stress & Fatigue?
            </h3>
            <p class="text-sm text-secondary leading-relaxed">
              Struggling to hear requires extra mental effort, which can be exhausting. Improved hearing makes conversations effortless and reduces stress, mental fatigue, and anxiety throughout the day.
            </p>
          </div>
          <div class="pt-6">
            <a href="/appointment-form/" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand hover:text-brand-dark">
              <span>Get Started</span>
              <Icon name="chevron-right" class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="glass-light rounded-3xl p-8 border border-white/80 shadow-md flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center font-extrabold text-base shadow-2xs">
              03
            </div>
            <h3 class="text-xl font-bold text-primary">
              Why is Clear Hearing Essential for Relationships?
            </h3>
            <p class="text-sm text-secondary leading-relaxed">
              It helps you engage in conversations effortlessly, strengthening your connections with family, friends, and colleagues while preventing misunderstandings and feelings of social isolation.
            </p>
          </div>
          <div class="pt-6">
            <a href="/appointment-form/" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand hover:text-brand-dark">
              <span>Get Started</span>
              <Icon name="chevron-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: 4 Steps to Better Hearing Health -->
  <section class="py-16" aria-labelledby="four-steps-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
        <span class="inline-block px-3.5 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs tracking-wider uppercase">
          Simple Process
        </span>
        <h2 id="four-steps-heading" class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight">
          4 Steps to Better Hearing Health
        </h2>
        <p class="text-secondary text-base">
          Getting the hearing care you need is straightforward and supportive at every stage.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative">
        <!-- Step 1 -->
        <div class="relative glass-light rounded-3xl p-6 border border-white/80 shadow-md flex flex-col justify-between glass-card-hover">
          <div class="space-y-3">
            <span class="w-10 h-10 rounded-2xl bg-brand text-inverse flex items-center justify-center font-bold text-sm shadow-xs">
              1
            </span>
            <h3 class="text-lg font-bold text-primary">Find the Nearest Clinic</h3>
            <p class="text-xs sm:text-sm text-secondary leading-relaxed">
              Locate a trusted HearMaxx clinic in Mississauga or York and take the first step!
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-border-subtle/80">
            <a href="/find-our-clinics/" class="text-xs font-bold text-brand hover:underline">
              Find Clinic →
            </a>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="relative glass-light rounded-3xl p-6 border border-white/80 shadow-md flex flex-col justify-between glass-card-hover">
          <div class="space-y-3">
            <span class="w-10 h-10 rounded-2xl bg-brand text-inverse flex items-center justify-center font-bold text-sm shadow-xs">
              2
            </span>
            <h3 class="text-lg font-bold text-primary">Book a Free Consultation</h3>
            <p class="text-xs sm:text-sm text-secondary leading-relaxed">
              Schedule a complimentary appointment with our certified hearing care specialist.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-border-subtle/80">
            <a href="/appointment-form/" class="text-xs font-bold text-brand hover:underline">
              Book Now →
            </a>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="relative glass-light rounded-3xl p-6 border border-white/80 shadow-md flex flex-col justify-between glass-card-hover">
          <div class="space-y-3">
            <span class="w-10 h-10 rounded-2xl bg-brand text-inverse flex items-center justify-center font-bold text-sm shadow-xs">
              3
            </span>
            <h3 class="text-lg font-bold text-primary">Get Expert Recommendations</h3>
            <p class="text-xs sm:text-sm text-secondary leading-relaxed">
              Receive personalized recommendations based on an accurate audiometric evaluation.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-border-subtle/80">
            <a href="/get-expert-advice/" class="text-xs font-bold text-brand hover:underline">
              Get Advice →
            </a>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="relative glass-light rounded-3xl p-6 border border-white/80 shadow-md flex flex-col justify-between glass-card-hover">
          <div class="space-y-3">
            <span class="w-10 h-10 rounded-2xl bg-brand text-inverse flex items-center justify-center font-bold text-sm shadow-xs">
              4
            </span>
            <h3 class="text-lg font-bold text-primary">Choose Your Solution</h3>
            <p class="text-xs sm:text-sm text-secondary leading-relaxed">
              Select the best digital hearing aid style or custom protection for your lifestyle.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-border-subtle/80">
            <a href="/explore-hearing-solutions/" class="text-xs font-bold text-brand hover:underline">
              Explore Solutions →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Benefits Grid -->
  <section class="py-16" aria-labelledby="benefits-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
        <span class="inline-block px-3.5 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
          Why Choose Us
        </span>
        <h2 id="benefits-heading" class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight">
          HearMaxx – Your Journey to Better Hearing Starts Here
        </h2>
        <p class="text-secondary text-base">
          Experience clinical precision, empathetic patient care, and cutting-edge digital technology.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Benefit 1 -->
        <div class="glass-strong rounded-3xl p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center">
              <Icon name="check" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-primary">Hearing Care Professional</h3>
            <p class="text-sm text-secondary leading-relaxed">
              Our certified hearing specialists over 20 years of experience provide personalized hearing care.
            </p>
          </div>
        </div>

        <!-- Benefit 2 -->
        <div class="glass-strong rounded-3xl p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center">
              <Icon name="check" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-primary">State-of-the-Art Technology</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We offer the latest digital hearing aids with advanced sound clarity for accurate hearing evaluations.
            </p>
          </div>
        </div>

        <!-- Benefit 3 -->
        <div class="glass-strong rounded-3xl p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center">
              <Icon name="check" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-primary">Free Hearing Tests & Consultation</h3>
            <p class="text-sm text-secondary leading-relaxed">
              Get a professional hearing checkup at no cost.
            </p>
          </div>
        </div>

        <!-- Benefit 4 -->
        <div class="glass-strong rounded-3xl p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center">
              <Icon name="check" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-primary">Ongoing Support & Adjustments</h3>
            <p class="text-sm text-secondary leading-relaxed">
              Enjoy free tuning and adjustments for a comfortable experience
            </p>
          </div>
        </div>

        <!-- Benefit 5 -->
        <div class="glass-strong rounded-3xl p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center">
              <Icon name="check" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-primary">Improved Quality of Life</h3>
            <p class="text-sm text-secondary leading-relaxed">
              Hear your loved ones clearly and enjoy conversations again.
            </p>
          </div>
        </div>

        <!-- Benefit 6 -->
        <div class="glass-strong rounded-3xl p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center">
              <Icon name="check" class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-primary">Affordable & Flexible Payment Plans</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We offer cost-effective solutions to fit every budget.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specialist Spotlight Section -->
  <section class="py-16" aria-labelledby="specialist-spotlight-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-5">
            <div class="rounded-3xl overflow-hidden glass-strong p-6 border border-white/90 shadow-xl max-w-md mx-auto flex items-center justify-center">
              <Image
                src={specialistImg}
                alt="Hearing aid technology fitted by Sheeraz Rahim at HearMaxx"
                width={450}
                height={450}
                class="w-full h-auto max-h-[360px] object-contain rounded-2xl"
                loading="lazy"
              />
            </div>
          </div>

          <div class="lg:col-span-7 space-y-6">
            <span class="inline-block px-3.5 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
              Specialist Care
            </span>
            <h2 id="specialist-spotlight-heading" class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight">
              Meet Sheeraz Rahim
            </h2>
            <p class="text-lg font-bold text-brand">
              {siteConfig.specialist.title} & Founder of HearMaxx
            </p>
            <p class="text-secondary text-base leading-relaxed">
              {siteConfig.specialist.bio} With {siteConfig.specialist.experience.toLowerCase()}, Sheeraz brings a compassionate, evidence-based approach to every evaluation, helping patients find optimal clarity and comfort.
            </p>
            <div class="grid grid-cols-2 gap-4 pt-4 border-t border-border-subtle/80 text-sm">
              <div class="p-4 rounded-2xl glass-strong border border-white/90">
                <span class="block text-2xl font-extrabold text-primary">20+</span>
                <span class="text-text-muted text-xs font-medium">Years Experience</span>
              </div>
              <div class="p-4 rounded-2xl glass-strong border border-white/90">
                <span class="block text-2xl font-extrabold text-primary">4.93★</span>
                <span class="text-text-muted text-xs font-medium">Patient Rating (105+ Reviews)</span>
              </div>
            </div>
            <div class="pt-2">
              <a
                href="/about-us/"
                class="inline-flex items-center gap-2 text-sm font-bold text-brand hover:underline"
              >
                <span>Read More About Our Story</span>
                <Icon name="chevron-right" class="w-4 h-4" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand Partners Strip -->
  <BrandStrip />

  <!-- CTA Banner (Glass Dark) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="glass-dark rounded-3xl p-8 sm:p-12 border border-white/20 shadow-2xl text-center space-y-6">
      <p class="text-xs uppercase font-bold tracking-widest text-sky-300">
        just make an appointment & you're done!
      </p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Need a hearing expert for a free ear check-up?
      </h2>
      <p class="text-lg text-slate-200 leading-relaxed max-w-2xl mx-auto">
        Step into a world of clear, vibrant sound with HearMaxx . Our passion for restoring hearing goes beyond technology—it's about enhancing every moment of your life. Embrace a future where every whisper and every cheer is beautifully heard.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4">
        <a
          href="/appointment-form/"
          class="btn-primary"
        >
          <Icon name="calendar" class="w-5 h-5" />
          <span>Book Free Appointment</span>
        </a>
        <a
          href="/contact-us/"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-base transition-colors border border-white/20"
        >
          <span>Contact us</span>
          <Icon name="chevron-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
