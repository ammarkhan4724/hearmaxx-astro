---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ContactForm from '../../components/ContactForm.astro';
import { siteConfig } from '../../data/site';
import { appointmentHeroImg } from '../../assets';
---

<BaseLayout
  title={`Contact Us – ${siteConfig.name}`}
  description="Let’s talk about your hearing. Tell us a little about what you need and a member of our team will get back to you. Reach us directly or visit our clinics in Ontario."
  canonicalPath="/contact-us/"
>
  <!-- Page Header with Background Image & Adjusted Transparency Overlay -->
  <header class="relative py-10 md:py-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-slate-950">
        <!-- Background Hero Image -->
        <Image
          src={appointmentHeroImg}
          alt="Friendly hearing care staff ready to assist and connect you with clinical care"
          width={1440}
          height={726}
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Dark Gradient Overlay for Maximum Text Visibility & Rich Contrast -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-900/60 z-0"></div>

        <!-- Content Overlay -->
        <div class="relative z-10 p-8 sm:p-12 lg:p-14">
          <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs text-slate-300 mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />
            <span class="text-white font-medium">Contact Us</span>
          </nav>

          <div class="max-w-3xl space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-full bg-brand/20 backdrop-blur-md text-sky-300 border border-sky-400/30 font-bold text-xs tracking-wider uppercase">
              Contact us
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              Let’s talk about your hearing
            </h1>
            <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl">
              Tell us a little about what you need and a member of our team will get back to you. If your question is urgent, please call a clinic directly.
            </p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left Column: Contact Cards -->
      <div class="lg:col-span-5 space-y-6">
        <div class="glass-light rounded-3xl p-8 border border-white/80 shadow-md space-y-4">
          <h2 class="text-2xl font-extrabold text-primary tracking-tight">Reach us directly</h2>
          <div class="flex flex-col gap-2 text-base font-bold text-brand">
            <a href="tel:+14167928792" class="hover:underline flex items-center gap-2">
              <Icon name="phone" class="w-4 h-4 text-brand" />
              <span>Reach us directly +1 (416) 792-8792</span>
            </a>
            <a href="tel:+19052327860" class="hover:underline flex items-center gap-2 pl-6">
              <span>+1 (905) 232-7860</span>
            </a>
          </div>
          <p class="text-sm text-secondary pt-1 leading-relaxed">
            Prefer to visit in person? Browse our clinic locations and book a time that suits you.
          </p>
          <div class="pt-2">
            <a
              href="/find-our-clinics/"
              class="btn-glass !text-xs !py-2.5 !px-5 inline-flex items-center gap-1.5"
            >
              <span>Find a clinic</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <!-- Mississauga Card -->
        <div class="glass-light rounded-3xl p-6 sm:p-8 border border-white/80 shadow-md space-y-4 glass-card-hover">
          <div class="flex items-center justify-between border-b border-border-subtle/80 pb-3">
            <h3 class="text-lg font-bold text-primary">Mississauga Clinic</h3>
            <span class="text-xs px-2.5 py-1 rounded-full bg-brand/10 text-brand font-semibold">Erindale Dental Centre</span>
          </div>

          <div class="space-y-3 text-sm">
            <p class="flex items-start gap-3 text-secondary">
              <Icon name="map-pin" class="w-5 h-5 text-brand shrink-0 mt-0.5" />
              <span>
                Located in Erindale Dental Centre 1151 Dundas Street Mississauga, ON 4C4,Canada
              </span>
            </p>

            <p class="flex items-center gap-3 text-secondary">
              <Icon name="phone" class="w-5 h-5 text-brand shrink-0" />
              <a href={`tel:${siteConfig.clinics.mississauga.phoneRaw}`} class="font-bold text-brand hover:underline">
                +1 905-232-7860
              </a>
            </p>

            <div class="pt-2 text-xs text-text-muted border-t border-border-subtle/80 space-y-1">
              <p class="font-semibold text-primary">Hours of Operation:</p>
              {siteConfig.clinics.mississauga.hours.map((h) => (
                <div class="flex justify-between">
                  <span>{h.days}</span>
                  <span class="font-medium text-primary">{h.time}</span>
                </div>
              ))}
            </div>

            <div class="pt-2">
              <a
                href={siteConfig.clinics.mississauga.googleMapsDirectionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand hover:underline"
              >
                <span>Get Directions</span>
                <Icon name="external" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </div>

        <!-- York Card -->
        <div class="glass-light rounded-3xl p-6 sm:p-8 border border-white/80 shadow-md space-y-4 glass-card-hover">
          <div class="flex items-center justify-between border-b border-border-subtle/80 pb-3">
            <h3 class="text-lg font-bold text-primary">York Clinic</h3>
            <span class="text-xs px-2.5 py-1 rounded-full bg-brand/10 text-brand font-semibold">Jane Park Plaza</span>
          </div>

          <div class="space-y-3 text-sm">
            <p class="flex items-start gap-3 text-secondary">
              <Icon name="map-pin" class="w-5 h-5 text-brand shrink-0 mt-0.5" />
              <span>
                Located in Jane Park Plaza 861 A Jane Street York, ON M6N 4C4,Canada
              </span>
            </p>

            <p class="flex items-center gap-3 text-secondary">
              <Icon name="phone" class="w-5 h-5 text-brand shrink-0" />
              <a href={`tel:${siteConfig.clinics.york.phoneRaw}`} class="font-bold text-brand hover:underline">
                +1 416-792-8792
              </a>
            </p>

            <div class="pt-2 text-xs text-text-muted border-t border-border-subtle/80 space-y-1">
              <p class="font-semibold text-primary">Hours of Operation:</p>
              {siteConfig.clinics.york.hours.map((h) => (
                <div class="flex justify-between">
                  <span>{h.days}</span>
                  <span class="font-medium text-primary">{h.time}</span>
                </div>
              ))}
            </div>

            <div class="pt-2">
              <a
                href={siteConfig.clinics.york.googleMapsDirectionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand hover:underline"
              >
                <span>Get Directions</span>
                <Icon name="external" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7">
        <ContactForm />
      </div>
    </div>
  </div>

  <!-- Bottom CTA (Glass Dark) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="glass-dark rounded-3xl p-8 sm:p-12 border border-white/20 shadow-2xl text-center space-y-6">
      <h2 class="text-3xl font-extrabold text-white tracking-tight">
        Step into a World of Clear, Vibrant Sound
      </h2>
      <p class="text-slate-200 text-sm max-w-2xl mx-auto leading-relaxed">
        Step into a world of clear, vibrant sound with HearMaxx . Our passion for restoring hearing goes beyond technology—it's about enhancing every moment of your life. Embrace a future where every whisper and every cheer is beautifully heard.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/appointment-form/"
          class="btn-primary"
        >
          Book Appointment
        </a>
        <a
          href="/find-our-clinics/"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-sm transition-colors border border-white/20"
        >
          Find Nearest Clinic
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
