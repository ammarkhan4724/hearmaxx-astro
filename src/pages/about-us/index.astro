---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import BrandStrip from '../../components/BrandStrip.astro';
import { siteConfig } from '../../data/site';
import {
  aboutHeroImg,
  aboutClinicImg,
  aboutClinicReceptionImg,
  aboutPatientConsultationImg,
  homeAudiologistSpecialist,
  clinicMississaugaImg,
} from '../../assets';
---

<BaseLayout
  title={`About Us & Our Mission – ${siteConfig.name}`}
  description="At HearMaxx, we combine empathy, expertise, and innovation to restore your hearing and transform your life. Discover our story and clinical values."
  canonicalPath="/about-us/"
>
  <!-- Page Header with Background Image & Adjusted Transparency Overlay -->
  <header class="relative py-10 md:py-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-slate-950">
        <!-- Background Hero Image -->
        <Image
          src={aboutHeroImg}
          alt="HearMaxx Patient Consultation and Care"
          width={1440}
          height={726}
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Dark Gradient Overlay for Maximum Text Visibility & Rich Contrast -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-900/60 z-0"></div>

        <!-- Content Overlay -->
        <div class="relative z-10 p-8 sm:p-12 lg:p-14">
          <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs text-slate-300 mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />
            <span class="text-white font-medium">About Us</span>
          </nav>

          <div class="max-w-3xl space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-full bg-brand/20 backdrop-blur-md text-sky-300 border border-sky-400/30 font-bold text-xs tracking-wider uppercase">
              Our Mission & Vision
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              Our Mission & Vision
            </h1>
            <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl">
              At HearMaxx, we combine empathy, expertise, and innovation to restore your hearing and transform your life
            </p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-16 space-y-16">
    <!-- Founder Story Section -->
    <section aria-labelledby="founder-story-heading" class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Story Text -->
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs font-bold uppercase tracking-wider text-brand">
            Empowering Better Hearing, Enhancing Lives
          </span>
          <h2 id="founder-story-heading" class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight">
            Twenty-Five Years of Clinical Excellence & Heartfelt Care
          </h2>
          <p class="text-secondary leading-relaxed text-base">
            Twenty-five years ago, a determined young immigrant arrived in Canada from a small city in a developing country, armed with little more than hope and a desire to make a difference. Facing language barriers and juggling part-time jobs, he pursued his dream of building a better future.
          </p>
          <p class="text-secondary leading-relaxed text-base">
            Over the years, HearMaxx grew into a trusted name in hearing care, known for its advanced technology and heartfelt commitment to improving lives. Today, it stands as a testament to one man’s vision, resilience, and dedication to reconnecting people with life’s meaningful moments.
          </p>

          <div class="p-5 rounded-2xl glass-strong border border-white/90 shadow-2xs flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-brand text-inverse flex items-center justify-center font-bold text-lg shrink-0 shadow-xs">
              SR
            </div>
            <div>
              <span class="block text-base font-bold text-primary">{siteConfig.specialist.name}</span>
              <span class="text-xs text-text-muted">{siteConfig.specialist.title} & Founder</span>
            </div>
          </div>
        </div>

        <!-- Specialist Image (Uncropped) -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="rounded-3xl overflow-hidden shadow-xl max-w-md w-full">
            <Image
              src={homeAudiologistSpecialist}
              alt="Sheeraz Rahim, Founder of HearMaxx"
              width={700}
              height={921}
              class="w-full h-auto max-h-[480px] object-cover rounded-3xl"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Clinic Facilities Showcase -->
    <section aria-labelledby="clinic-facilities-heading" class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 rounded-3xl overflow-hidden glass-strong p-3 border border-white/90 shadow-lg flex items-center justify-center">
          <Image
            src={clinicMississaugaImg}
            alt="HearMaxx Clinic Facilities - Modern consultation and testing suites in Ontario"
            width={800}
            height={500}
            class="w-full h-full aspect-16/10 object-cover rounded-2xl"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="lg:col-span-6 space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-brand">
            Clinical Environment
          </span>
          <h2 id="clinic-facilities-heading" class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
            Our Clinic – Dedicated to Your Hearing Health
          </h2>
          <p class="text-secondary leading-relaxed text-sm sm:text-base">
            Visit our welcoming, state-of-the-art clinics in Mississauga and York. Equipped with advanced sound-treated evaluation rooms and precision fitting suites, we ensure a comfortable, confidential experience every step of the way.
          </p>
          <div class="pt-2 flex flex-wrap gap-4">
            <a href="/find-our-clinics/" class="btn-primary text-xs sm:text-sm">
              Find Our Clinics
            </a>
            <a href="/appointment-form/" class="btn-glass text-xs sm:text-sm">
              Book Visit
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Video Showcase Section -->
    <section aria-labelledby="video-showcase-heading" class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="inline-block px-3.5 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
          Inside Our Practice
        </span>
        <h2 id="video-showcase-heading" class="text-3xl font-extrabold text-primary tracking-tight">
          Hear Directly from Sheeraz Rahim
        </h2>
        <p class="text-secondary text-sm leading-relaxed max-w-2xl mx-auto">
          Hear directly from Sheeraz Rahim, the founder and lead hearing care specialist at HearMaxx, as he walks you through what makes our clinic different. From the personalized assessments to the latest in hearing aid technology, discover how we’re transforming lives with better hearing — one patient at a time.
        </p>
        <p class="text-secondary text-sm leading-relaxed max-w-2xl mx-auto">
          Our commitment extends beyond assessments; we are dedicated to educating our patients about their hearing health and the available options to improve it. By combining state-of-the-art technology with individualized care plans, we strive to enhance our patients' quality of life through better hearing.​
        </p>
        <div class="pt-2">
          <a
            href="/appointment-form/"
            class="btn-primary"
          >
            Book Appointment
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        <!-- Video 1: Services Overview (9:16 Uncropped with Full Frame Poster) -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover space-y-4">
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-primary">Services & Clinical Approach</h3>
            <p class="text-xs sm:text-sm text-secondary leading-relaxed">
              Walk through what makes our clinic different—from personalized assessments to real-ear verification and tailored brand selection.
            </p>
            <div class="rounded-2xl overflow-hidden shadow-inner bg-black aspect-[9/16] max-h-[75vh] max-w-[340px] mx-auto border border-border-subtle flex items-center justify-center">
              <video
                controls
                preload="none"
                poster="/videos/clinic-services-poster.webp"
                playsinline
                class="w-full h-full object-contain"
                aria-label="Services overview video with Sheeraz Rahim"
              >
                <source src="/videos/clinic-services.webm" type="video/webm" />
                <source src="/videos/clinic-services.mp4" type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            </div>
            <p class="text-xs text-text-muted pt-1 text-center">
              <a href="/videos/clinic-services.mp4" class="underline hover:text-brand" download>Download / Direct Video Link</a>
            </p>
          </div>
        </div>

        <!-- Video 2: Clinic Tour (9:16 Uncropped with Full Frame Poster) -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover space-y-4">
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-primary">Tour Our Clinic Facilities</h3>
            <p class="text-xs sm:text-sm text-secondary leading-relaxed">
              Explore our modern consultation rooms, sound-treated testing suites, and welcoming patient care environment in Ontario.
            </p>
            <div class="rounded-2xl overflow-hidden shadow-inner bg-black aspect-[9/16] max-h-[75vh] max-w-[340px] mx-auto border border-border-subtle flex items-center justify-center">
              <video
                controls
                preload="none"
                poster="/videos/clinic-tour-poster.webp"
                playsinline
                class="w-full h-full object-contain"
                aria-label="HearMaxx clinic walkthrough and facilities tour"
              >
                <source src="/videos/clinic-tour.webm" type="video/webm" />
                <source src="/videos/clinic-tour.mp4" type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            </div>
            <p class="text-xs text-text-muted pt-1 text-center">
              <a href="/videos/clinic-tour.mp4" class="underline hover:text-brand" download>Download / Direct Video Link</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Values Section -->
    <section aria-labelledby="core-values-heading" class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-2">
        <span class="inline-block px-3.5 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
          Our Core Values
        </span>
        <h2 id="core-values-heading" class="text-3xl font-extrabold text-primary tracking-tight">
          Our Core values
        </h2>
        <p class="text-secondary text-sm">
          Every consultation and treatment plan at HearMaxx is guided by six foundational principles.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
          <div class="w-10 h-10 rounded-xl bg-brand text-inverse flex items-center justify-center font-bold text-sm mb-4 shadow-xs">
            01
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">Patient-Centered Care</h3>
          <p class="text-xs sm:text-sm text-secondary leading-relaxed">
            We listen first. Every recommendation is uniquely molded around your acoustic prescription, daily lifestyle, and comfort goals.
          </p>
        </div>

        <div class="p-6 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
          <div class="w-10 h-10 rounded-xl bg-brand text-inverse flex items-center justify-center font-bold text-sm mb-4 shadow-xs">
            02
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">Professional Excellence</h3>
          <p class="text-xs sm:text-sm text-secondary leading-relaxed">
            With over two decades of clinical experience, our specialists maintain rigorous continuing education and evidence-based protocols.
          </p>
        </div>

        <div class="p-6 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
          <div class="w-10 h-10 rounded-xl bg-brand text-inverse flex items-center justify-center font-bold text-sm mb-4 shadow-xs">
            03
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">Integrity and Transparency</h3>
          <p class="text-xs sm:text-sm text-secondary leading-relaxed">
            Clear, honest advice without hidden charges or high-pressure sales. We only recommend devices that genuinely benefit your hearing.
          </p>
        </div>

        <div class="p-6 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
          <div class="w-10 h-10 rounded-xl bg-brand text-inverse flex items-center justify-center font-bold text-sm mb-4 shadow-xs">
            04
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">Empowerment Through Education</h3>
          <p class="text-xs sm:text-sm text-secondary leading-relaxed">
            We ensure you thoroughly understand your audiogram, inner ear mechanics, and device controls so you feel in full control of your care.
          </p>
        </div>

        <div class="p-6 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
          <div class="w-10 h-10 rounded-xl bg-brand text-inverse flex items-center justify-center font-bold text-sm mb-4 shadow-xs">
            05
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">Commitment to Innovation</h3>
          <p class="text-xs sm:text-sm text-secondary leading-relaxed">
            We partner with world-leading hearing aid manufacturers to provide cutting-edge noise filtering, Bluetooth streaming, and rechargeability.
          </p>
        </div>

        <div class="p-6 rounded-2xl glass-strong border border-white/90 shadow-2xs glass-card-hover">
          <div class="w-10 h-10 rounded-xl bg-brand text-inverse flex items-center justify-center font-bold text-sm mb-4 shadow-xs">
            06
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">Community Engagement</h3>
          <p class="text-xs sm:text-sm text-secondary leading-relaxed">
            Proudly serving families across Mississauga and York with accessible screenings, educational workshops, and ongoing community support.
          </p>
        </div>
      </div>
    </section>

    <!-- Get in Touch with Us Section -->
    <section class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md">
      <div class="max-w-4xl mx-auto text-center space-y-4">
        <h2 class="text-3xl font-extrabold text-primary tracking-tight">Get in Touch with Us</h2>
        <p class="text-xs font-semibold uppercase tracking-wider text-brand">
          Your Journey to Better Hearing Starts Here
        </p>
        <p class="text-secondary text-base leading-relaxed max-w-2xl mx-auto">
          We're dedicated to providing personalized hearing solutions tailored to your needs. Whether you have questions about our services, need assistance with your hearing aids, or wish to schedule a consultation, our team is here to help. Reach out to us today and take the first step towards improved hearing health.
        </p>
        <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact-us/"
            class="btn-primary"
          >
            Contact Our Clinics
          </a>
          <a
            href="/appointment-form/"
            class="btn-glass"
          >
            Book Consultation
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- Brand Partners Strip -->
  <BrandStrip />

  <!-- Bottom CTA (Glass Dark with Photographic Depth) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="relative glass-dark rounded-3xl p-8 sm:p-14 border border-white/20 shadow-2xl text-center space-y-6 overflow-hidden">
      <!-- Background Image with Gradient Overlay -->
      <div class="absolute inset-0 pointer-events-none">
        <Image
          src={aboutPatientConsultationImg}
          alt="Joy of clear sound and hearing rehabilitation"
          width={1200}
          height={600}
          class="w-full h-full object-cover opacity-15 mix-blend-luminosity scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-primary/95 via-primary/85 to-primary/90"></div>
      </div>

      <div class="relative z-10 max-w-3xl mx-auto space-y-6">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Let's Begin Your Journey to Better Hearing
        </h2>
        <p class="text-slate-200 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Ready to take the first step toward improved hearing? Our team at HearMaxx is here to provide you with personalized care and the latest hearing solutions tailored to your needs. Click below to schedule your consultation and start your journey to better hearing today.
        </p>
        <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/appointment-form/"
            class="btn-primary shadow-lg shadow-brand/25"
          >
            Join Our Mission Today
          </a>
          <a
            href="/find-our-clinics/"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-sm transition-colors border border-white/20 shadow-sm"
          >
            Find Nearest Clinic
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
