---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../data/site';
import { clinicMississaugaImg, clinicsHeroImg } from '../../assets';
---

<BaseLayout
  title={`Find a Clinic Near You – ${siteConfig.name}`}
  description="Locate our clinics with detailed addresses, hours, and directions for each location. Mississauga and York clinics."
  canonicalPath="/find-our-clinics/"
  type="clinic"
>
  <!-- Page Header with Background Image & Adjusted Transparency Overlay -->
  <header class="relative py-10 md:py-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-slate-950">
        <!-- Background Hero Image -->
        <Image
          src={clinicsHeroImg}
          alt="HearMaxx clinic exterior and welcoming entrance"
          width={1440}
          height={726}
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Dark Gradient Overlay for Maximum Text Visibility & Rich Contrast -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-900/60 z-0"></div>

        <!-- Content Overlay -->
        <div class="relative z-10 p-8 sm:p-12 lg:p-14">
          <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs text-slate-300 mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />
            <span class="text-white font-medium">Find Our Clinics</span>
          </nav>

          <div class="max-w-3xl space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-full bg-brand/20 backdrop-blur-md text-sky-300 border border-sky-400/30 font-bold text-xs tracking-wider uppercase">
              Our Clinics
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              Find a Clinic Near You
            </h1>
            <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl">
              Locate our clinics with detailed addresses, hours, and directions for each location across the Greater Toronto Area.
            </p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-16 space-y-16">
    <!-- Clinic 1: Mississauga -->
    <section class="glass-light rounded-3xl border border-white/80 shadow-md overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
        <!-- Clinic Details -->
        <div class="lg:col-span-5 p-8 sm:p-10 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <span class="inline-block px-3 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
              Location 1
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
              Visit Our Mississauga Clinic
            </h2>
            <div class="rounded-2xl overflow-hidden shadow-xs border border-white/90 aspect-16/10 w-full">
              <Image
                src={clinicMississaugaImg}
                alt="HearMaxx Mississauga Clinic storefront and entrance in Erindale Dental Centre"
                width={800}
                height={500}
                class="w-full h-full object-cover rounded-2xl"
                loading="lazy"
              />
            </div>
            <p class="text-sm text-secondary">
              Westdale Mall 1151 Dundas Street Mississauga, ON 4C4, Canada
            </p>

            <div class="pt-2 space-y-3 text-sm text-secondary">
              <div class="flex items-start gap-3">
                <Icon name="map-pin" class="w-5 h-5 text-brand shrink-0 mt-0.5" />
                <div>
                  <strong class="block text-primary">Located in Erindale Dental Centre 1151 Dundas Street Mississauga, ON 4C4,Canada</strong>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <Icon name="phone" class="w-5 h-5 text-brand shrink-0" />
                <div>
                  <a href={`tel:${siteConfig.clinics.mississauga.phoneRaw}`} class="font-bold text-brand hover:underline">
                    +1 905-232-7860
                  </a>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <Icon name="mail" class="w-5 h-5 text-brand shrink-0" />
                <div>
                  <a href={`mailto:${siteConfig.clinics.mississauga.email}`} class="hover:underline">
                    {siteConfig.clinics.mississauga.email}
                  </a>
                </div>
              </div>
            </div>

            <div class="pt-3 border-t border-border-subtle/80">
              <h3 class="text-xs font-bold uppercase tracking-wider text-text-muted mb-2">Hours of Operation</h3>
              <p class="text-xs text-secondary leading-relaxed">
                Mon – Fri : 10:00 – 17:00 Sat : 13:00 – 16:00 Sun : Closed
              </p>
            </div>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row gap-3">
            <a
              href="/appointment-form/"
              class="btn-primary !text-xs !py-3 !px-6"
            >
              Book at Mississauga
            </a>
            <a
              href={siteConfig.clinics.mississauga.googleMapsDirectionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-glass !text-xs !py-3 !px-6"
            >
              <span>More Info on Google Maps</span>
              <Icon name="external" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <!-- Google Maps Embed / Facade -->
        <div class="lg:col-span-7 glass-strong min-h-[380px] relative border-t lg:border-t-0 lg:border-l border-white/80 flex flex-col items-center justify-center">
          <div
            class="map-facade-wrapper w-full h-full min-h-[400px] relative flex flex-col items-center justify-center"
            data-src={siteConfig.clinics.mississauga.googleMapsEmbedUrl}
            data-title="Google Map for HearMaxx Mississauga Clinic"
          >
            <div class="map-placeholder-content p-6 text-center space-y-3">
              <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center mx-auto shadow-2xs">
                <Icon name="map-pin" class="w-6 h-6 text-brand" />
              </div>
              <div>
                <p class="font-bold text-primary text-sm">Interactive Map: Mississauga Clinic</p>
                <p class="text-xs text-secondary mt-0.5">1151 Dundas Street, Erindale Dental Centre</p>
              </div>
              <button
                type="button"
                class="load-map-btn btn-primary !text-xs !py-2.5 !px-5 cursor-pointer"
                aria-label="Load interactive Google Map for Mississauga Clinic"
              >
                Load Interactive Map
              </button>
            </div>
            <noscript>
              <iframe
                src={siteConfig.clinics.mississauga.googleMapsEmbedUrl}
                width="100%"
                height="100%"
                style="border:0; min-height: 400px;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Google Map for HearMaxx Mississauga Clinic"
                class="w-full h-full absolute inset-0"
              ></iframe>
            </noscript>
          </div>
        </div>
      </div>
    </section>

    <!-- Clinic 2: York (Jane St) -->
    <section class="glass-light rounded-3xl border border-white/80 shadow-md overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
        <!-- Clinic Details -->
        <div class="lg:col-span-5 p-8 sm:p-10 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <span class="inline-block px-3 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
              Location 2
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
              Visit Our York Clinic
            </h2>
            <p class="text-sm text-secondary">
              Located in Jane Park Plaza 861 A Jane St York, ON M6N 4C4, Canada
            </p>

            <div class="pt-2 space-y-3 text-sm text-secondary">
              <div class="flex items-start gap-3">
                <Icon name="map-pin" class="w-5 h-5 text-brand shrink-0 mt-0.5" />
                <div>
                  <strong class="block text-primary">Located in Jane Park Plaza 861 A Jane Street York, ON M6N 4C4,Canada</strong>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <Icon name="phone" class="w-5 h-5 text-brand shrink-0" />
                <div>
                  <a href={`tel:${siteConfig.clinics.york.phoneRaw}`} class="font-bold text-brand hover:underline">
                    +1 416-792-8792
                  </a>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <Icon name="mail" class="w-5 h-5 text-brand shrink-0" />
                <div>
                  <a href={`mailto:${siteConfig.clinics.york.email}`} class="hover:underline">
                    {siteConfig.clinics.york.email}
                  </a>
                </div>
              </div>
            </div>

            <div class="pt-3 border-t border-border-subtle/80">
              <h3 class="text-xs font-bold uppercase tracking-wider text-text-muted mb-2">Hours of Operation</h3>
              <p class="text-xs text-secondary leading-relaxed">
                Mon – Fri : 09:00 – 17:00 Sat : 09:00 – 12:00 Sun : Closed
              </p>
            </div>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row gap-3">
            <a
              href="/appointment-form/"
              class="btn-primary !text-xs !py-3 !px-6"
            >
              Book at York
            </a>
            <a
              href={siteConfig.clinics.york.googleMapsDirectionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-glass !text-xs !py-3 !px-6"
            >
              <span>More Info on Google Maps</span>
              <Icon name="external" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <!-- Google Maps Embed / Facade -->
        <div class="lg:col-span-7 glass-strong min-h-[380px] relative border-t lg:border-t-0 lg:border-l border-white/80 flex flex-col items-center justify-center">
          <div
            class="map-facade-wrapper w-full h-full min-h-[400px] relative flex flex-col items-center justify-center"
            data-src={siteConfig.clinics.york.googleMapsEmbedUrl}
            data-title="Google Map for HearMaxx York Clinic in Jane Park Plaza"
          >
            <div class="map-placeholder-content p-6 text-center space-y-3">
              <div class="w-12 h-12 rounded-2xl bg-brand/10 text-brand flex items-center justify-center mx-auto shadow-2xs">
                <Icon name="map-pin" class="w-6 h-6 text-brand" />
              </div>
              <div>
                <p class="font-bold text-primary text-sm">Interactive Map: York Clinic</p>
                <p class="text-xs text-secondary mt-0.5">Located in Jane Park Plaza, 861 A Jane St</p>
              </div>
              <button
                type="button"
                class="load-map-btn btn-primary !text-xs !py-2.5 !px-5 cursor-pointer"
                aria-label="Load interactive Google Map for York Clinic"
              >
                Load Interactive Map
              </button>
            </div>
            <noscript>
              <iframe
                src={siteConfig.clinics.york.googleMapsEmbedUrl}
                width="100%"
                height="100%"
                style="border:0; min-height: 400px;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Google Map for HearMaxx York Clinic in Jane Park Plaza"
                class="w-full h-full absolute inset-0"
              ></iframe>
            </noscript>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Bottom CTA (Glass Dark) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="glass-dark rounded-3xl p-8 sm:p-12 border border-white/20 shadow-2xl text-center space-y-6">
      <h2 class="text-3xl font-extrabold text-white tracking-tight">
        Step into a World of Clear, Vibrant Sound
      </h2>
      <p class="text-slate-200 text-sm max-w-2xl mx-auto leading-relaxed">
        Step into a world of clear, vibrant sound with HearMaxx . Our passion for restoring hearing goes beyond technology—it's about enhancing every moment of your life. Embrace a future where every whisper and every cheer is beautifully heard.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/appointment-form/"
          class="btn-primary"
        >
          Book Appointment
        </a>
        <a
          href="/contact-us/"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-sm transition-colors border border-white/20"
        >
          Contact Our Clinics
        </a>
      </div>
    </div>
  </section>

  <script>
    function initMapFacades() {
      const wrappers = document.querySelectorAll('.map-facade-wrapper');
      wrappers.forEach((el) => {
        const wrapper = el as HTMLElement;
        const src = wrapper.dataset.src;
        const title = wrapper.dataset.title;
        if (!src) return;

        function loadMap() {
          if (wrapper.querySelector('iframe')) return;
          const iframe = document.createElement('iframe');
          iframe.src = src;
          iframe.title = title || 'Interactive Map';
          iframe.width = '100%';
          iframe.height = '100%';
          iframe.style.border = '0';
          iframe.style.minHeight = '400px';
          iframe.className = 'w-full h-full absolute inset-0';
          iframe.allowFullscreen = true;
          iframe.loading = 'lazy';
          iframe.referrerPolicy = 'no-referrer-when-downgrade';

          const placeholder = wrapper.querySelector('.map-placeholder-content');
          if (placeholder) placeholder.remove();
          wrapper.appendChild(iframe);
        }

        const btn = wrapper.querySelector('.load-map-btn');
        btn?.addEventListener('click', loadMap);

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                loadMap();
                obs.disconnect();
              }
            });
          }, { rootMargin: '300px' });
          observer.observe(wrapper);
        }
      });
    }

    initMapFacades();
    document.addEventListener('astro:page-load', initMapFacades);
  </script>
</BaseLayout>
