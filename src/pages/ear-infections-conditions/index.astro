---
import { Image } from 'astro:assets';
import {
  infectionsMiddleEarImg,
  infectionsIllustration,
  infectionsCareBannerImg
} from '../../assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Icon from '../../components/Icon.astro';
import { getEntry } from 'astro:content';
import { siteConfig } from '../../data/site';

const entry = await getEntry('hearingHealth', 'ear-infections-conditions');
if (!entry) {
  throw new Error('Content entry not found');
}

const infectionFaqs = [
  {
    question: "Otitis Externa (Swimmer's Ear)",
    answer: "An infection of the outer ear canal, often caused by water remaining in the ear after swimming, creating a moist environment that aids bacterial growth.​Symptoms:Itching in the ear canalRedness inside the earDiscomfort or pain, especially when touching the earDrainage of clear, odorless fluidTreatment: Cleaning the ear canal and applying prescribed ear drops to eliminate infection and reduce inflammation.​",
  },
  {
    question: "Otitis Media (Middle Ear Infection)",
    answer: "An infection of the middle ear, commonly occurring in children, often following a cold or respiratory infection.Symptoms:Ear painFeverHearing difficultiesFluid drainage from the earTreatment: Observation for mild cases; antibiotics for persistent or severe infections. In recurrent cases, surgical intervention like tympanostomy tubes may be considered.​",
  },
  {
    question: "Otitis Media with Effusion (Glue Ear)",
    answer: "Accumulation of fluid in the middle ear without signs of infection, often following an ear infection.Symptoms:Muffled hearingA feeling of fullness in the earBalance problems​Treatment: Often resolves on its own; persistent cases may require ear tubes to drain fluid and restore hearing.",
  },
];

const otherConditionsFaqs = [
  {
    question: "Tympanic Membrane Perforation(Ruptured Eardrum)",
    answer: "A hole or tear in the eardrum, which can result from infections, trauma, or sudden pressure changes.Symptoms:Sudden hearing lossEar painTinnitusFluid drainageTreatment: Many perforations heal on their own; persistent cases may require surgical repair (tympanoplasty).​",
  },
  {
    question: "Labyrinthitis",
    answer: "Inflammation of the inner ear labyrinth, often resulting from viral infections.​Symptoms:VertigoHearing lossTinnitusNausea and imbalanceTreatment: Medications to control symptoms and, in some cases, corticosteroids to reduce inflammation.​",
  },
  {
    question: "Eustachian Tube Dysfunction",
    answer: "Occurs when the Eustachian tube fails to open properly, leading to pressure differences and fluid accumulation.Symptoms:Ear fullnessMuffled hearingTinnitusDizzinessTreatment: Decongestants, antihistamines, nasal steroids, or surgical interventions like balloon dilation in chronic cases.​​",
  },
];
---

<BaseLayout
  title={`${entry.data.title} – ${siteConfig.name}`}
  description={entry.data.description}
  canonicalPath="/ear-infections-conditions/"
  type="article"
  article={{
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.publishDate,
    authorName: entry.data.author,
  }}
>
  <!-- Page Header with Background Image & Adjusted Transparency Overlay -->
  <header class="relative py-10 md:py-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-slate-950">
        <!-- Background Hero Image -->
        <Image
          src={infectionsCareBannerImg}
          alt="Audiologist examining a patient's ear for infections and conditions"
          width={1440}
          height={726}
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Dark Gradient Overlay for Maximum Text Visibility & Rich Contrast -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-900/60 z-0"></div>

        <!-- Content Overlay -->
        <div class="relative z-10 p-8 sm:p-12 lg:p-14 reveal-down">
          <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs text-slate-300 mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />
            <span class="text-slate-300">Hearing Health</span>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />
            <span class="text-white font-medium">{entry.data.title}</span>
          </nav>

          <div class="max-w-3xl space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-full bg-brand/20 backdrop-blur-md text-sky-300 border border-sky-400/30 font-bold text-xs tracking-wider uppercase">
              {entry.data.category}
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              {entry.data.title}
            </h1>
            <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl">
              {entry.data.description}
            </p>

            <div class="flex flex-wrap items-center gap-4 mt-6 pt-6 border-t border-white/20 text-xs text-slate-300">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-full bg-brand text-inverse flex items-center justify-center font-bold text-xs shadow-xs">
                  SR
                </span>
                <div>
                  <span class="font-semibold text-white block">{entry.data.author}</span>
                  <span>{entry.data.authorTitle}</span>
                </div>
              </div>
              <span class="text-slate-500">•</span>
              <span class="font-medium text-emerald-300 bg-emerald-500/20 px-2 py-0.5 rounded-full border border-emerald-400/30">Clinically Reviewed</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Article Body -->
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-6 pb-16 space-y-12">
    <!-- Featured Image in Glass Frame (Uncropped) -->
    <div class="rounded-3xl overflow-hidden glass-strong p-3 sm:p-4 border border-white/90 shadow-md max-w-lg mx-auto flex items-center justify-center reveal-scale">
      <Image
        src={infectionsMiddleEarImg}
        alt="Anatomical diagram of the middle ear and Eustachian tube structure"
        width={920}
        height={980}
        class="w-full h-auto max-h-[420px] object-contain rounded-2xl mx-auto"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <!-- Introduction Card (68ch Measure) -->
    <div class="glass-light rounded-3xl p-8 sm:p-10 border border-white/80 shadow-md reveal-up">
      <h2 class="sr-only">Ear Infections & Conditions</h2>
      <p class="text-secondary text-base sm:text-lg leading-relaxed max-w-[68ch]">
        At HearMaxx, under the expert guidance of our hearing expert Sheeraz Rahim, we are dedicated to providing comprehensive information and care for various ear-related issues. Understanding these conditions is the first step toward effective treatment and better hearing health. ​
      </p>
    </div>

    <!-- Group 1: Common Ear Infections (Premium FAQ) -->
    <section class="space-y-6">
      <div class="rounded-3xl overflow-hidden glass-strong p-3 sm:p-4 border border-white/90 shadow-md max-w-2xl mx-auto flex flex-col items-center reveal-down">
        <div class="w-full rounded-2xl overflow-hidden aspect-16/9 bg-white shadow-xs">
          <Image
            src={infectionsIllustration}
            alt="Medical comparison of normal healthy tympanic membrane versus acute otitis media infection"
            width={960}
            height={540}
            class="w-full h-full object-cover rounded-2xl"
            loading="lazy"
          />
        </div>
        <p class="text-xs text-text-muted text-center mt-2.5 font-medium">
          Clinical comparison: Normal healthy eardrum structure vs. Acute Otitis Media with purulent effusion and inflammation.
        </p>
      </div>
      <div class="reveal-up">
        <FaqAccordion
          title="Common Ear Infections, Symptoms & Treatment"
          subtitle="Detailed clinical profiles, symptoms, and medical treatment protocols."
          items={infectionFaqs}
          groupName="ear-infections-group"
          showControls={false}
          enableJsonLd={true}
        />
      </div>
    </section>

    <!-- Group 2: Other Ear Conditions (Premium FAQ) -->
    <section class="space-y-4 reveal-up">
      <FaqAccordion
        title="Other Ear Conditions"
        subtitle="Evaluation and therapeutic pathways for complex middle and inner ear disorders."
        items={otherConditionsFaqs}
        groupName="other-conditions-group"
        showControls={false}
        enableJsonLd={true}
      />
    </section>

    <!-- Hearing Loss Types -->
    <section class="glass-light rounded-3xl p-8 sm:p-10 border border-white/80 shadow-md space-y-8" aria-labelledby="hearing-loss-types-heading">
      <div class="reveal-down">
        <h2 id="hearing-loss-types-heading" class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
          Hearing Loss Types
        </h2>
        <p class="text-secondary text-sm mt-1">
          Understanding the mechanism and anatomical site of auditory impairment.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Conductive -->
        <div class="glass-strong rounded-2xl p-6 border border-white/90 shadow-2xs space-y-4 glass-card-hover reveal-left">
          <h3 class="text-xl font-bold text-primary">
            Conductive Hearing Loss
          </h3>
          <p class="text-sm text-secondary leading-relaxed">
            Occurs when sound waves are blocked from reaching the inner ear, often due to earwax build up, infections, or structural issues.
          </p>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand mb-2">Causes:​</h4>
            <ul class="space-y-1.5 text-xs text-secondary">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
                <span>Ear infections</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
                <span>Fluid in the middle ear</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
                <span>Earwax blockage</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
                <span>Otosclerosis</span>
              </li>
            </ul>
          </div>

          <div class="pt-3 border-t border-border-subtle/80 text-xs text-secondary leading-relaxed">
            <strong class="text-primary font-bold">Treatment:</strong> Medical or surgical interventions to remove blockages or correct structural problems,
          </div>
        </div>

        <!-- Sensorineural -->
        <div class="glass-strong rounded-2xl p-6 border border-white/90 shadow-2xs space-y-4 glass-card-hover reveal-right">
          <h3 class="text-xl font-bold text-primary">
            Sensorineural Hearing Loss
          </h3>
          <p class="text-sm text-secondary leading-relaxed">
            Results from damage to the inner ear or auditory nerve often permanent.
          </p>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand mb-2">Causes:</h4>
            <ul class="space-y-1.5 text-xs text-secondary">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
                <span>Exposure to loud noise</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
                <span>Infections</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
                <span>Genetic factors</span>
              </li>
            </ul>
          </div>

          <div class="pt-3 border-t border-border-subtle/80 text-xs text-secondary leading-relaxed">
            <strong class="text-primary font-bold">Treatment:</strong> Hearing aids or cochlear implants to improve hearing ability. ​
          </div>
        </div>
      </div>
    </section>

    <!-- Prevention Tips -->
    <section class="glass-light rounded-3xl p-8 sm:p-10 border border-white/80 shadow-md space-y-6" aria-labelledby="prevention-tips-heading">
      <div class="reveal-down">
        <h2 id="prevention-tips-heading" class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
          Prevention Tips
        </h2>
        <p class="text-secondary text-sm mt-1">
          Simple daily practices to maintain outer and middle ear health.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-sm text-secondary">
        <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white/60 border border-white/80 reveal-left reveal-delay-100">
          <span class="p-1 rounded-full bg-emerald-100 text-emerald-700 mt-0.5 shrink-0">
            <Icon name="check" class="w-3.5 h-3.5" />
          </span>
          <span>Keep ears dry and clean.</span>
        </div>
        <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white/60 border border-white/80 reveal-right reveal-delay-200">
          <span class="p-1 rounded-full bg-emerald-100 text-emerald-700 mt-0.5 shrink-0">
            <Icon name="check" class="w-3.5 h-3.5" />
          </span>
          <span>Avoid inserting objects into the ear canal.</span>
        </div>
        <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white/60 border border-white/80 reveal-left reveal-delay-300">
          <span class="p-1 rounded-full bg-emerald-100 text-emerald-700 mt-0.5 shrink-0">
            <Icon name="check" class="w-3.5 h-3.5" />
          </span>
          <span>Manage allergies and upper respiratory infections promptly.</span>
        </div>
        <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white/60 border border-white/80 reveal-right reveal-delay-400">
          <span class="p-1 rounded-full bg-emerald-100 text-emerald-700 mt-0.5 shrink-0">
            <Icon name="check" class="w-3.5 h-3.5" />
          </span>
          <span>Stay up-to-date with vaccinations.</span>
        </div>
        <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white/60 border border-white/80 sm:col-span-2 reveal-up reveal-delay-500">
          <span class="p-1 rounded-full bg-emerald-100 text-emerald-700 mt-0.5 shrink-0">
            <Icon name="check" class="w-3.5 h-3.5" />
          </span>
          <span>Limit exposure to loud noises to prevent noise-induced hearing loss. ​</span>
        </div>
      </div>
    </section>

    <!-- Ear Health Consultation Banner (Aligned with sections, border-radius preserved, no white border) -->
    <div class="mt-12 w-full rounded-3xl overflow-hidden shadow-lg reveal-scale">
      <Image
        src={infectionsCareBannerImg}
        alt="Comprehensive ear health care and specialist consultation support"
        width={1280}
        height={500}
        class="w-full h-auto max-h-[360px] object-cover rounded-3xl"
        loading="lazy"
      />
    </div>

    <!-- Consultation CTA Card (Glass Dark with Photographic Depth) -->
    <div class="relative mt-8 p-8 sm:p-12 rounded-3xl glass-dark border border-white/20 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-8 overflow-hidden reveal-scale">
      <!-- Background Image with Gradient Overlay -->
      <div class="absolute inset-0 pointer-events-none">
        <Image
          src={infectionsCareBannerImg}
          alt="Comprehensive ear health care and specialist consultation support"
          width={1200}
          height={600}
          class="w-full h-full object-cover opacity-20 mix-blend-luminosity scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-primary/95 via-primary/85 to-primary/90"></div>
      </div>

      <div class="relative z-10 space-y-3">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Need Help with Ear Issues?
        </h2>
        <p class="text-slate-200 text-sm sm:text-base max-w-xl leading-relaxed font-normal">
          If you're experiencing any ear-related symptoms or have concerns about your hearing, don't hesitate to reach out to HearMaxx. Our hearing expert Sheeraz Rahim, is here to provide personalized care and effective solutions for your ear health.
        </p>
      </div>
      <div class="relative z-10 shrink-0 flex flex-col sm:flex-row gap-3 w-full md:w-auto">
        <a
          href="/appointment-form/"
          class="btn-primary shadow-lg shadow-brand/25 text-center"
        >
          Book Consultation
        </a>
        <a
          href={`tel:${siteConfig.clinics.mississauga.phoneRaw}`}
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-sm transition-colors text-center border border-white/20"
        >
          Call (905) 232-7860
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
