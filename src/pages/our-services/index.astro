---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import BrandStrip from '../../components/BrandStrip.astro';
import { siteConfig } from '../../data/site';
import {
  servicesHeroImg,
  serviceEvaluationImg,
  serviceTympanometryImg,
  serviceEarHealthImg,
  serviceConsultationImg,
  serviceFittingImg,
  serviceMaintenanceImg,
  serviceEarwaxImg,
  serviceProtectionImg,
  serviceTinnitusImg,
  serviceTechEvaluation,
  serviceTechFitting,
  serviceTechConsultation,
  serviceOngoingSupportImg,
  appointmentHeroImg,
} from '../../assets';
---

<BaseLayout
  title={`Our Services – ${siteConfig.name}`}
  description="From assessment to fitting, our experts provide the best hearing solutions: comprehensive hearing evaluations, tympanometry, custom fitting, maintenance, and earwax management."
  canonicalPath="/our-services/"
>
  <!-- Page Header with Background Image & Adjusted Transparency Overlay -->
  <header class="relative py-10 md:py-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-slate-950">
        <!-- Background Hero Image -->
        <Image
          src={servicesHeroImg}
          alt="Audiologist conducting diagnostic examination and hearing consultation"
          width={1440}
          height={726}
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Dark Gradient Overlay for Maximum Text Visibility & Rich Contrast -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-900/60 z-0"></div>

        <!-- Content Overlay -->
        <div class="relative z-10 p-8 sm:p-12 lg:p-14 reveal-down">
          <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs text-slate-300 mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />
            <span class="text-white font-medium">Our Services</span>
          </nav>

          <div class="max-w-3xl space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-full bg-brand/20 backdrop-blur-md text-sky-300 border border-sky-400/30 font-bold text-xs tracking-wider uppercase">
              Expert Hearing Care
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              From Assessment to Fitting: Our Expert Provide Best Hearing Solutions
            </h1>
            <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl">
              Benefit from personalized assessments, advanced fittings, and expert follow-up to ensure your hearing aids perform at their best.
            </p>
            <p class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-sky-300 pt-1">
              We offer extensive Range of Hearing Services
            </p>
          </div>

          <!-- Quick Navigation Buttons & Anchors -->
          <div class="pt-8 space-y-4">
            <!-- CTA Buttons -->
            <div class="flex flex-wrap gap-3">
              <a
                href="/appointment-form/"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-semibold text-sm shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5"
              >
                <Icon name="calendar" class="w-4 h-4 fill-current text-slate-900" />
                <span>Book Appointment</span>
              </a>
              <a
                href="/contact-us/"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-white/40 bg-white/15 hover:bg-white/25 text-white font-semibold text-sm backdrop-blur-md transition-all shadow-sm hover:shadow-md hover:border-white/70 hover:-translate-y-0.5"
              >
                <Icon name="phone" class="w-4 h-4 fill-current text-white" />
                <span>Contact Clinic</span>
              </a>
            </div>

            <!-- Service Category Anchors -->
            <div class="flex flex-wrap gap-2 pt-1">
              <a href="#diagnostic-services-heading" class="px-3.5 py-1.5 rounded-full bg-slate-900/60 hover:bg-white/20 border border-white/25 text-xs font-medium text-slate-200 hover:text-white transition-all backdrop-blur-md">
                Diagnostics & Evaluations ↓
              </a>
              <a href="#hearing-aid-solutions-heading" class="px-3.5 py-1.5 rounded-full bg-slate-900/60 hover:bg-white/20 border border-white/25 text-xs font-medium text-slate-200 hover:text-white transition-all backdrop-blur-md">
                Hearing Aids & Custom Fitting ↓
              </a>
              <a href="#ear-health-protection-heading" class="px-3.5 py-1.5 rounded-full bg-slate-900/60 hover:bg-white/20 border border-white/25 text-xs font-medium text-slate-200 hover:text-white transition-all backdrop-blur-md">
                Ear Health & Protection ↓
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Services Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-16 space-y-16">
    <!-- Pillar 1: Diagnostic & Evaluation Services -->
    <section aria-labelledby="diagnostic-services-heading" class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md space-y-8 reveal-left">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand">(Diagnostic & Evaluation Services)</span>
          <h2 id="diagnostic-services-heading" class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight mt-1">
            Rediscover the Joy of Hearing with Our Expert Care & Services
          </h2>
          <p class="text-secondary text-sm mt-1 max-w-2xl">
            Accurate diagnostics and thorough ear evaluations tailored to identify hearing loss and ear conditions.
          </p>
        </div>
        <div class="hidden md:flex w-24 h-24 rounded-3xl overflow-hidden glass-light p-2 border border-white/80 shadow-2xs shrink-0 items-center justify-center">
          <Image
            src={serviceEvaluationImg}
            alt="Advanced audiology diagnostic testing equipment"
            width={512}
            height={512}
            class="w-full h-full object-contain rounded-xl aspect-square"
            loading="lazy"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover reveal-up reveal-delay-100">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-2xl overflow-hidden glass-light border border-white/80 p-2.5 shadow-2xs shrink-0 flex items-center justify-center">
              <Image
                src={serviceEvaluationImg}
                alt="Comprehensive Hearing Evaluations"
                width={96}
                height={96}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-bold text-primary">Comprehensive Hearing Evaluations</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We offer comprehensive hearing assessments using advanced tests to accurately identify hearing loss and create personalized treatment plans.
            </p>
          </div>
          <div class="pt-6">
            <a href="/appointment-form/" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
              Book Evaluation →
            </a>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover reveal-up reveal-delay-200">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-2xl overflow-hidden glass-light border border-white/80 p-2.5 shadow-2xs shrink-0 flex items-center justify-center">
              <Image
                src={serviceTympanometryImg}
                alt="Tympanometry Middle Ear Testing"
                width={96}
                height={96}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-bold text-primary">Tympanometry</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We provide tympanometry testing to evaluate middle ear function, helping to identify issues such as fluid buildup or eardrum perforations, which are essential for accurate diagnosis and effective treatment.
            </p>
          </div>
          <div class="pt-6">
            <a href="/appointment-form/" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
              Book Evaluation →
            </a>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover reveal-up reveal-delay-300">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-2xl overflow-hidden glass-light border border-white/80 p-2.5 shadow-2xs shrink-0 flex items-center justify-center">
              <Image
                src={serviceEarHealthImg}
                alt="Overall Ear Health Management"
                width={96}
                height={96}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-bold text-primary">Overall Ear Health Management</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We provide routine ear check-ups, professional earwax removal, infection screening, and early detection of ear conditions to support your complete hearing health.
            </p>
          </div>
          <div class="pt-6">
            <a href="/appointment-form/" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
              Book Evaluation →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Pillar 2: Hearing Aid Solutions -->
    <section aria-labelledby="hearing-aid-solutions-heading" class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md space-y-8 reveal-right">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand">(Hearing Aid Solutions)</span>
          <h2 id="hearing-aid-solutions-heading" class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight mt-1">
            Hearing Aid Consultation & Selection
          </h2>
          <p class="text-secondary text-sm mt-1 max-w-2xl">
            Independent guidance across global manufacturers to ensure the ideal acoustic and ergonomic match.
          </p>
        </div>
        <div class="hidden md:flex w-24 h-24 rounded-3xl overflow-hidden glass-light p-2 border border-white/80 shadow-2xs shrink-0 items-center justify-center">
          <Image
            src={serviceConsultationImg}
            alt="Precision tuning and adjustment of hearing aid devices"
            width={512}
            height={512}
            class="w-full h-full object-contain rounded-xl aspect-square"
            loading="lazy"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover reveal-up reveal-delay-100">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-2xl overflow-hidden glass-light border border-white/80 p-2.5 shadow-2xs shrink-0 flex items-center justify-center">
              <Image
                src={serviceConsultationImg}
                alt="Hearing Aid Consultation & Selection"
                width={96}
                height={96}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-bold text-primary">Hearing Aid Consultation & Selection</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We provide personalized consultations to help you select the most suitable hearing aid, considering your lifestyle, hearing needs, and budget, ensuring optimal hearing enhancement.
            </p>
          </div>
          <div class="pt-6">
            <a href="/explore-hearing-solutions/" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
              Explore Solutions →
            </a>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover reveal-up reveal-delay-200">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-2xl overflow-hidden glass-light border border-white/80 p-2.5 shadow-2xs shrink-0 flex items-center justify-center">
              <Image
                src={serviceFittingImg}
                alt="Custom Fitting Services"
                width={96}
                height={96}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-bold text-primary">Custom Fitting Services</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We provide custom fitting and programming of hearing aids, utilizing real-ear measurements to ensure the devices are tailored to your unique hearing profile for maximum comfort and effectiveness.
            </p>
          </div>
          <div class="pt-6">
            <a href="/appointment-form/" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
              Schedule Fitting →
            </a>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover reveal-up reveal-delay-300">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-2xl overflow-hidden glass-light border border-white/80 p-2.5 shadow-2xs shrink-0 flex items-center justify-center">
              <Image
                src={serviceMaintenanceImg}
                alt="Maintenance & Repairs"
                width={96}
                height={96}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-bold text-primary">Maintenance & Repairs</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We provide ongoing maintenance and repair services for your hearing aids, including cleaning, adjustments, and troubleshooting, to ensure they function optimally at all times.
            </p>
          </div>
          <div class="pt-6">
            <a href="/appointment-form/" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
              Request Service →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Pillar 3: Ear Health & Protection -->
    <section aria-labelledby="ear-health-protection-heading" class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md space-y-8 reveal-left">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand">(Ear Health & Protection)</span>
          <h2 id="ear-health-protection-heading" class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight mt-1">
            Ear Health & Auditory Protection
          </h2>
          <p class="text-secondary text-sm mt-1 max-w-2xl">
            Preventative care, cerumen management, and specialized sound therapy solutions.
          </p>
        </div>
        <div class="hidden md:flex w-24 h-24 rounded-3xl overflow-hidden glass-light p-2 border border-white/80 shadow-2xs shrink-0 items-center justify-center">
          <Image
            src={serviceProtectionImg}
            alt="Custom ear protection and auditory preservation devices"
            width={512}
            height={512}
            class="w-full h-full object-contain rounded-xl aspect-square"
            loading="lazy"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover reveal-up reveal-delay-100">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-2xl overflow-hidden glass-light border border-white/80 p-2.5 shadow-2xs shrink-0 flex items-center justify-center">
              <Image
                src={serviceEarwaxImg}
                alt="Earwax (Cerumen) Management"
                width={96}
                height={96}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-bold text-primary">Earwax (Cerumen) Management</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We provide professional earwax removal services using safe and effective techniques to prevent blockages that can affect hearing and hearing aid performance.
            </p>
          </div>
          <div class="pt-6">
            <a href="/appointment-form/" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
              Book Ear Cleaning →
            </a>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover reveal-up reveal-delay-200">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-2xl overflow-hidden glass-light border border-white/80 p-2.5 shadow-2xs shrink-0 flex items-center justify-center">
              <Image
                src={serviceProtectionImg}
                alt="Custom Ear Protection"
                width={96}
                height={96}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-bold text-primary">Custom Ear Protection</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We provide custom-fitted earplugs designed for various activities such as swimming, sleeping, or exposure to loud environments, offering maximum comfort and protection.
            </p>
          </div>
          <div class="pt-6">
            <a href="/explore-hearing-solutions/#custom-protection" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
              View Earplugs →
            </a>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="glass-strong rounded-3xl p-6 sm:p-8 border border-white/90 shadow-2xs flex flex-col justify-between glass-card-hover reveal-up reveal-delay-300">
          <div class="space-y-4">
            <div class="w-16 h-16 rounded-2xl overflow-hidden glass-light border border-white/80 p-2.5 shadow-2xs shrink-0 flex items-center justify-center">
              <Image
                src={serviceTinnitusImg}
                alt="Tinnitus Management"
                width={96}
                height={96}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <h3 class="text-xl font-bold text-primary">Tinnitus Management</h3>
            <p class="text-sm text-secondary leading-relaxed">
              We offer targeted tinnitus counseling services to support the effective management of the perception of ringing or buzzing in the ears.
            </p>
          </div>
          <div class="pt-6">
            <a href="/what-is-tinnitus/" class="text-xs font-bold text-brand hover:underline inline-flex items-center gap-1">
              Learn More →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Why You Need Professional Hearing Care Services? -->
    <section aria-labelledby="why-need-care-heading" class="glass-light rounded-3xl p-8 sm:p-12 border border-white/80 shadow-md space-y-12 reveal-scale">
      <div class="text-center max-w-4xl mx-auto space-y-4">
        <span class="inline-block px-3.5 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">Get Started Today</span>
        <h2 id="why-need-care-heading" class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight">
          Why You Need Professional Hearing Care Services?
        </h2>
        <p class="text-secondary text-base leading-relaxed max-w-3xl mx-auto">
          Hearing is one of life’s greatest gifts, yet many underestimate its importance until challenges arise. Untreated hearing loss doesn’t just affect your ability to hear—it impacts your relationships, work, and overall quality of life. Our professional hearing care services are here to bridge that gap. Whether it’s through comprehensive assessments, personalized hearing aid solutions, or expert guidance, we ensure that your journey to better hearing is seamless and effective. Don’t let hearing issues hold you back—let us help you reconnect with the moments that matters the most.
        </p>
        <div class="pt-3">
          <a
            href="/appointment-form/"
            class="btn-primary"
          >
            Request Appointment
          </a>
        </div>
      </div>

      <!-- 3 Key Value Photographic Alternating Sections -->
      <div class="space-y-12">
        <!-- Section 1: Advanced Technology (Image Left, Content Right) -->
        <div class="glass-strong rounded-3xl p-6 sm:p-10 border border-white/90 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-5 order-2 lg:order-1 reveal-left">
            <div class="rounded-3xl overflow-hidden shadow-md border border-white/90 aspect-4/3 sm:aspect-16/10">
              <Image
                src={serviceTechEvaluation}
                alt="Advanced Hearing Aid Technology and 3D Ear Anatomy Evaluation"
                width={800}
                height={533}
                class="w-full h-full object-cover rounded-3xl"
                loading="lazy"
              />
            </div>
          </div>
          <div class="lg:col-span-7 order-1 lg:order-2 space-y-4 reveal-right">
            <span class="inline-block px-3 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
              Cutting-Edge Innovation
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
              Advanced Technology You Can Trust
            </h3>
            <p class="text-xs font-semibold uppercase tracking-wider text-brand">
              Stay connected with cutting-edge hearing aids.
            </p>
            <p class="text-sm sm:text-base text-secondary leading-relaxed">
              From Bluetooth-enabled devices to invisible hearing aids, we offer the latest technology from top manufacturers, ensuring you get the best sound quality and comfort. Experience seamless streaming, discreet designs, and tailored amplification for every environment.
            </p>
            <div class="pt-2">
              <a
                href="/explore-hearing-solutions/"
                class="btn-primary !text-xs !py-2.5 !px-5 inline-flex"
              >
                Explore Technologies →
              </a>
            </div>
          </div>
        </div>

        <!-- Section 2: Cognitive Health (Content Left, Image Right) -->
        <div class="glass-strong rounded-3xl p-6 sm:p-10 border border-white/90 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-7 space-y-4 reveal-left">
            <span class="inline-block px-3 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
              Brain Health & Vitality
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
              Protecting Cognitive Health Through Hearing Care
            </h3>
            <p class="text-xs font-semibold uppercase tracking-wider text-brand">
              Better Hearing, Sharper Mind
            </p>
            <p class="text-sm sm:text-base text-secondary leading-relaxed">
              Scientific studies show a strong link between untreated hearing loss and cognitive decline, including memory loss and increased risk of dementia. At our clinic, we take this connection seriously. By addressing hearing loss early with expert care and appropriate devices, you can protect not only your hearing but also your mental well-being. Let us help you stay mentally sharp, socially connected, and fully engaged in the life you love.
            </p>
            <div class="pt-2">
              <a
                href="/the-impact-of-untreated-hearing-loss/"
                class="btn-primary !text-xs !py-2.5 !px-5 inline-flex"
              >
                Learn More About Cognitive Health →
              </a>
            </div>
          </div>
          <div class="lg:col-span-5 reveal-right">
            <div class="rounded-3xl overflow-hidden shadow-md border border-white/90 aspect-4/3 sm:aspect-16/10">
              <Image
                src={serviceTechFitting}
                alt="Senior enjoying mental clarity and cognitive wellness through proper hearing care"
                width={800}
                height={533}
                class="w-full h-full object-cover rounded-3xl"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <!-- Section 3: Ongoing Support (Image Left, Content Right) -->
        <div class="glass-strong rounded-3xl p-6 sm:p-10 border border-white/90 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-5 order-2 lg:order-1 reveal-left">
            <div class="rounded-3xl overflow-hidden shadow-md border border-white/90 flex items-center justify-center">
              <Image
                src={serviceOngoingSupportImg}
                alt="Compassionate audiologist providing ongoing hearing care support and patient consultation"
                width={800}
                height={800}
                class="w-full h-auto max-h-[380px] object-cover rounded-3xl"
                loading="lazy"
              />
            </div>
          </div>
          <div class="lg:col-span-7 order-1 lg:order-2 space-y-4 reveal-right">
            <span class="inline-block px-3 py-1 rounded-full bg-brand/10 text-brand font-bold text-xs uppercase tracking-wider">
              Lifelong Partnership
            </span>
