---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import AppointmentForm from '../../components/AppointmentForm.astro';
import { siteConfig } from '../../data/site';
import { appointmentHeroImg, clinicMississaugaImg } from '../../assets';
---

<BaseLayout
  title={`Book Free Appointment Today! – ${siteConfig.name}`}
  description="No cost. No commitment. Just better hearing — get started by submitting your request below. Schedule a consultation at HearMaxx Mississauga or York."
  canonicalPath="/appointment-form/"
>
  <!-- Page Header with Background Image & Adjusted Transparency Overlay -->
  <header class="relative py-10 md:py-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-slate-950">
        <!-- Background Hero Image -->
        <Image
          src={appointmentHeroImg}
          alt="Licensed audiologist providing compassionate hearing consultation and evaluation"
          width={1440}
          height={726}
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Dark Gradient Overlay for Maximum Text Visibility & Rich Contrast -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-900/60 z-0"></div>

        <!-- Content Overlay -->
        <div class="relative z-10 p-8 sm:p-12 lg:p-14">
          <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs text-slate-300 mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <Icon name="chevron-right" class="w-3 h-3 text-slate-400" />
            <span class="text-white font-medium">Book Appointment</span>
          </nav>

          <div class="max-w-3xl space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-full bg-brand/20 backdrop-blur-md text-sky-300 border border-sky-400/30 font-bold text-xs tracking-wider uppercase">
              Complimentary Evaluation
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              Book Free Appointment Today!
            </h1>
            <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl">
              No cost. No commitment. Just better hearing — get started by submitting your request below.
            </p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Interactive Appointment Form (Placed above on mobile, side-by-side on desktop) -->
      <div class="lg:col-span-7 order-1 lg:order-2">
        <AppointmentForm />
      </div>

      <!-- Clinic Information & General Inquiries (Below form on mobile, left column on desktop) -->
      <div class="lg:col-span-5 space-y-6 order-2 lg:order-1">
        <!-- Clinic Storefront Photo Centered with Border Radius -->
        <div class="rounded-3xl overflow-hidden glass-strong p-3 sm:p-4 border border-white/90 shadow-md flex items-center justify-center">
          <Image
            src={clinicMississaugaImg}
            alt="HearMaxx Mississauga hearing clinic welcoming storefront"
            width={720}
            height={540}
            class="w-full h-auto max-h-72 sm:max-h-80 object-cover rounded-2xl mx-auto shadow-xs"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="glass-light rounded-3xl p-8 border border-white/80 shadow-md space-y-6">
          <div class="space-y-2">
            <h2 class="text-2xl font-extrabold text-primary tracking-tight">
              General Inquiries
            </h2>
            <p class="text-sm text-secondary leading-relaxed">
              Have Questions? Not ready to book yet? We’re here to help with anything you need. Reach out via phone, email, social networks or our contact form — no question is too small!
            </p>
          </div>

          <div class="pt-4 border-t border-border-subtle/80">
            <p class="text-xs font-bold uppercase tracking-wider text-brand mb-3">
              Reach Our Clinics Directly:
            </p>
            <div class="space-y-4 text-sm">
              <div class="p-4 rounded-2xl bg-white/70 border border-white/90 shadow-2xs">
                <span class="font-bold text-primary block text-base">Mississauga Clinic:</span>
                <a href={`tel:${siteConfig.clinics.mississauga.phoneRaw}`} class="font-bold text-brand hover:underline block my-0.5">
                  +1 905-232-7860
                </a>
                <p class="text-xs text-text-muted">{siteConfig.clinics.mississauga.street}, Mississauga, ON</p>
              </div>
              <div class="p-4 rounded-2xl bg-white/70 border border-white/90 shadow-2xs">
                <span class="font-bold text-primary block text-base">York Clinic:</span>
                <a href={`tel:${siteConfig.clinics.york.phoneRaw}`} class="font-bold text-brand hover:underline block my-0.5">
                  +1 416-792-8792
                </a>
                <p class="text-xs text-text-muted">{siteConfig.clinics.york.street}, York, ON</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Rating Callout -->
        <div class="p-8 rounded-3xl glass-strong border border-white/90 shadow-md text-center space-y-3 glass-card-hover">
          <div class="flex justify-center text-amber-500 gap-1" role="img" aria-label="5 star rating">
            <Icon name="star" class="w-5 h-5 fill-current" />
            <Icon name="star" class="w-5 h-5 fill-current" />
            <Icon name="star" class="w-5 h-5 fill-current" />
            <Icon name="star" class="w-5 h-5 fill-current" />
            <Icon name="star" class="w-5 h-5 fill-current" />
          </div>
          <p class="font-extrabold text-primary text-lg">{siteConfig.ratingLine}</p>
          <p class="text-xs text-text-muted">{siteConfig.trustBadge}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Question & Contact Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="p-8 sm:p-12 rounded-3xl glass-dark border border-white/20 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Have Questions? Not ready to book yet?
        </h2>
        <p class="text-slate-200 text-sm max-w-xl leading-relaxed">
          We’re here to help with anything you need. Reach out via phone, email, or our contact form — no question is too small!
        </p>
      </div>
      <div class="shrink-0 flex flex-col sm:flex-row gap-3.5 w-full md:w-auto">
        <a
          href="/contact-us/"
          class="btn-primary"
        >
          Contact Our Team
        </a>
        <a
          href="/find-our-clinics/"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-sm transition-colors text-center border border-white/20"
        >
          Find Nearest Clinic
        </a>
      </div>
    </div>
  </section>

  <!-- Bottom CTA (Glass Dark) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="glass-dark rounded-3xl p-8 sm:p-12 border border-white/20 shadow-2xl text-center space-y-6">
      <h2 class="text-3xl font-extrabold text-white tracking-tight">
        Step into a World of Clear, Vibrant Sound
      </h2>
      <p class="text-slate-200 text-sm max-w-2xl mx-auto leading-relaxed">
        Step into a world of clear, vibrant sound with HearMaxx . Our passion for restoring hearing goes beyond technology—it's about enhancing every moment of your life. Embrace a future where every whisper and every cheer is beautifully heard.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact-us/"
          class="btn-primary"
        >
          Contact Our Clinics
        </a>
        <a
          href="/find-our-clinics/"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-sm transition-colors border border-white/20"
        >
          Find Nearest Clinic
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
