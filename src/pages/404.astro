---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`Page Not Found (404) – ${siteConfig.name}`}
  description="The page you are looking for does not exist or has been moved. Explore Hear Maxx hearing solutions and clinic locations."
  canonicalPath="/404"
>
  <div class="min-h-[75vh] flex items-center justify-center py-20 px-4 sm:px-6">
    <div class="glass-strong rounded-3xl p-8 sm:p-12 shadow-xl border border-white/80 max-w-xl mx-auto text-center space-y-6">
      <span class="inline-block px-4 py-1.5 rounded-full bg-brand/10 text-brand font-bold text-xs tracking-wider uppercase border border-brand/20">
        Error 404
      </span>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-primary tracking-tight">
        Page Not Found
      </h1>

      <p class="text-secondary text-base sm:text-lg leading-relaxed">
        The page you are looking for might have been moved or is no longer available. Let's help you get back on track.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="btn-primary"
        >
          <span>Back to Home</span>
          <Icon name="chevron-right" class="w-4 h-4" />
        </a>
        <a
          href="/find-our-clinics/"
          class="btn-glass"
        >
          <span>Find Our Clinics</span>
        </a>
      </div>

      <div class="pt-8 border-t border-border-subtle/80">
        <p class="text-xs font-bold text-secondary uppercase tracking-wider mb-3">
          Popular Links
        </p>
        <div class="flex flex-wrap justify-center gap-2.5 text-xs font-semibold text-secondary">
          <a href="/explore-hearing-solutions/" class="px-3 py-1.5 rounded-full bg-white/60 hover:bg-white text-primary border border-border-subtle hover:border-brand/40 transition-colors">Hearing Solutions</a>
          <a href="/our-services/" class="px-3 py-1.5 rounded-full bg-white/60 hover:bg-white text-primary border border-border-subtle hover:border-brand/40 transition-colors">Our Services</a>
          <a href="/appointment-form/" class="px-3 py-1.5 rounded-full bg-white/60 hover:bg-white text-primary border border-border-subtle hover:border-brand/40 transition-colors">Book Appointment</a>
          <a href="/get-expert-advice/" class="px-3 py-1.5 rounded-full bg-white/60 hover:bg-white text-primary border border-border-subtle hover:border-brand/40 transition-colors">Hearing Advice & FAQs</a>
          <a href="/contact-us/" class="px-3 py-1.5 rounded-full bg-white/60 hover:bg-white text-primary border border-border-subtle hover:border-brand/40 transition-colors">Contact Us</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
